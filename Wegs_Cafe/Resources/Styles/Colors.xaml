<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== Weg's Cafe brand palette ===== -->
    <Color x:Key="PrimaryBlack">#0A0A0A</Color>
    <Color x:Key="PureWhite">#FFFFFF</Color>
    <Color x:Key="OffWhiteCream">#F7F6F2</Color>
    <Color x:Key="CharcoalSurface">#1C1C1E</Color>
    <Color x:Key="BorderGray">#E2E2E0</Color>
    <Color x:Key="MutedText">#6E6E73</Color>
    <Color x:Key="AlertWarning">#D97706</Color>   <!-- Low Stock only -->
    <Color x:Key="AlertDanger">#DC2626</Color>    <!-- Out of Stock / Void only -->
    <Color x:Key="AlertSuccess">#16A34A</Color>   <!-- Paid / Synced only -->

    <SolidColorBrush x:Key="PrimaryBlackBrush" Color="{StaticResource PrimaryBlack}"/>
    <SolidColorBrush x:Key="PureWhiteBrush" Color="{StaticResource PureWhite}"/>
    <SolidColorBrush x:Key="OffWhiteCreamBrush" Color="{StaticResource OffWhiteCream}"/>
    <SolidColorBrush x:Key="CharcoalSurfaceBrush" Color="{StaticResource CharcoalSurface}"/>
    <SolidColorBrush x:Key="BorderGrayBrush" Color="{StaticResource BorderGray}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedText}"/>
    <SolidColorBrush x:Key="AlertWarningBrush" Color="{StaticResource AlertWarning}"/>
    <SolidColorBrush x:Key="AlertDangerBrush" Color="{StaticResource AlertDanger}"/>
    <SolidColorBrush x:Key="AlertSuccessBrush" Color="{StaticResource AlertSuccess}"/>

    <!-- ===== Template keys re-mapped to the monochrome palette
         (the default MAUI styles in Styles.xaml reference these) ===== -->
    <Color x:Key="Primary">#0A0A0A</Color>
    <Color x:Key="PrimaryDark">#F7F6F2</Color>
    <Color x:Key="PrimaryDarkText">#0A0A0A</Color>
    <Color x:Key="Secondary">#E2E2E0</Color>
    <Color x:Key="SecondaryDarkText">#6E6E73</Color>
    <Color x:Key="Tertiary">#1C1C1E</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
