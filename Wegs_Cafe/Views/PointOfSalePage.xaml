<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Wegs_Cafe.ViewModels"
             xmlns:models="clr-namespace:Wegs_Cafe.Models"
             x:Class="Wegs_Cafe.Views.PointOfSalePage"
             x:DataType="vm:PointOfSaleViewModel"
             x:Name="PointOfSaleRootPage"
             Title="{Binding PageTitle}"
             BackgroundColor="{StaticResource PureWhite}">

    <Grid>
        <!-- Root Adaptive Container: Single column on Phone, Split-screen on Tablet/Desktop -->
        <Grid x:Name="PointOfSaleContainer"
              Padding="12,8"
              ColumnDefinitions="{OnIdiom Phone='*', Tablet='1.85*,1.15*', Desktop='1.85*,1.15*'}"
              RowDefinitions="Auto,*,Auto"
              ColumnSpacing="{OnIdiom Phone=0, Tablet=16, Desktop=16}"
              RowSpacing="10">

            <!-- Row 0: Compact Top Utility & Sync Bar (Never Clipped) -->
            <Grid Grid.Row="0"
                  Grid.Column="0"
                  Grid.ColumnSpan="{OnIdiom Phone=1, Tablet=2, Desktop=2}"
                  ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="8">

                <!-- Col 0: Pill-Shaped Sync Status Indicator -->
                <Border Grid.Column="0"
                        BackgroundColor="{Binding SyncStatusColor}"
                        StrokeThickness="0"
                        Padding="12,7"
                        HorizontalOptions="Start"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowSyncStatusCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Image Source="{Binding SyncStatusIcon}"
                               WidthRequest="16"
                               HeightRequest="16"
                               VerticalOptions="Center" />
                        <Label Text="{Binding SyncStatusText}"
                               FontFamily="QuicksandBold"
                               FontSize="12"
                               TextColor="{StaticResource PureWhite}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Col 1: Orders / Void Drawer Button -->
                <Button Grid.Column="1"
                        Text="Orders"
                        ImageSource="receipt_long.png"
                        Style="{StaticResource PrimaryBlackButton}"
                        HeightRequest="34"
                        Padding="12,4"
                        CornerRadius="17"
                        FontSize="12"
                        Command="{Binding ToggleOrderHistoryPanelCommand}" />

                <!-- Col 2: Printer Settings Button -->
                <Button Grid.Column="2"
                        Text="Printer"
                        ImageSource="print.png"
                        Style="{StaticResource PrimaryBlackButton}"
                        HeightRequest="34"
                        Padding="12,4"
                        CornerRadius="17"
                        FontSize="12"
                        Command="{Binding ConfigureBluetoothPrinterCommand}" />
            </Grid>

            <!-- Row 1, Col 0: Main Product Catalog Area (Full width on Phone, Left 62% on Tablet) -->
            <Grid Grid.Row="1"
                  Grid.Column="0"
                  RowDefinitions="Auto,Auto,Auto,*"
                  RowSpacing="10">

                <!-- Live Barista Order Queue Strip -->
                <Border Grid.Row="0"
                        BackgroundColor="{StaticResource OffWhiteCream}"
                        Stroke="{StaticResource BorderGray}"
                        StrokeThickness="1"
                        Padding="10,6"
                        IsVisible="{Binding HasActiveQueueOrders}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                            <Border BackgroundColor="{StaticResource PrimaryBlack}" WidthRequest="24" HeightRequest="24" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Image Source="local_cafe.png" WidthRequest="13" HeightRequest="13" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="QUEUE" FontFamily="QuicksandBold" FontSize="11" TextColor="{StaticResource PrimaryBlack}" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <ScrollView Grid.Column="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding ActiveQueueOrders}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Order">
                                        <Border BackgroundColor="{StaticResource PureWhite}"
                                                Stroke="{StaticResource BorderGray}"
                                                StrokeThickness="1"
                                                Padding="10,5">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference PointOfSaleRootPage}, Path=BindingContext.AdvanceOrderPreparationStatusCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                <Label Text="{Binding CustomerOrTableLabel}" FontFamily="QuicksandBold" FontSize="11.5" TextColor="{StaticResource PrimaryBlack}" VerticalOptions="Center" />
                                                <Border BackgroundColor="{StaticResource StatusWarning}" Padding="7,2" StrokeThickness="0">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsReadyForPickup}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource StatusSuccess}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Label Text="{Binding PreparationStatus}" FontFamily="QuicksandBold" FontSize="10" TextColor="{StaticResource PureWhite}" />
                                                </Border>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </Grid>
                </Border>

                <!-- Full-Width Search Bar -->
                <Border Grid.Row="1" Style="{StaticResource SearchPillBorder}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Border Grid.Column="0" BackgroundColor="{StaticResource PrimaryBlack}" WidthRequest="28" HeightRequest="28" StrokeThickness="0" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Image Source="search.png" WidthRequest="15" HeightRequest="15" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Entry Grid.Column="1"
                               Text="{Binding SearchQuery}"
                               Placeholder="Search menu item or SKU..."
                               BackgroundColor="Transparent"
                               TextColor="{StaticResource PrimaryBlack}" />
                    </Grid>
                </Border>

                <!-- Category Filter Pills -->
                <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Categories}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Text="{Binding .}"
                                        Style="{StaticResource OutlineSecondaryButton}"
                                        HeightRequest="36"
                                        Padding="14,0"
                                        CornerRadius="18"
                                        FontSize="12"
                                        Command="{Binding Source={x:Reference PointOfSaleRootPage}, Path=BindingContext.SelectCategoryCommand}"
                                        CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Virtualized Product Catalog Grid -->
                <CollectionView Grid.Row="3"
                                ItemsSource="{Binding FilteredProducts}"
                                ItemSizingStrategy="MeasureFirstItem"
                                RemainingItemsThreshold="-1"
                                SelectionMode="None"
                                IsVisible="{Binding IsOrderHistoryPanelVisible, Converter={StaticResource InverseBoolConverter}}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="{OnIdiom Phone=2, Tablet=3, Desktop=3}"
                                         HorizontalItemSpacing="10"
                                         VerticalItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Product">
                            <Border StrokeShape="RoundRectangle 14"
                                    StrokeThickness="1"
                                    Stroke="#E2E2E0"
                                    BackgroundColor="#F7F6F2"
                                    Padding="10"
                                    HeightRequest="142"
                                    Shadow="{x:Null}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsAvailable}" Value="False">
                                        <Setter Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnProductCardTapped" />
                                </Border.GestureRecognizers>

                                <Grid RowDefinitions="Auto,*,Auto,Auto"
                                      ColumnDefinitions="*,Auto"
                                      RowSpacing="4">
                                    <!-- Row 0, Col 0: Category badge -->
                                    <Border Grid.Row="0"
                                            Grid.Column="0"
                                            BackgroundColor="{StaticResource PureWhite}"
                                            Padding="6,2"
                                            StrokeThickness="0"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Category}"
                                               FontFamily="InterSemiBold"
                                               FontSize="10"
                                               TextColor="#52525B"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1"
                                               HorizontalOptions="Start" />
                                    </Border>

                                    <!-- Row 0, Col 1: Compact interactive Stock/Availability pill -->
                                    <Border Grid.Row="0"
                                            Grid.Column="1"
                                            Padding="8,2"
                                            StrokeThickness="0"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsAvailable}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#16A34A" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsAvailable}" Value="False">
                                                <Setter Property="BackgroundColor" Value="#DC2626" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PointOfSaleViewModel}}, Path=ToggleProductAvailabilityCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label FontFamily="QuicksandBold"
                                               FontSize="10"
                                               TextColor="{StaticResource PureWhite}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsAvailable}" Value="True">
                                                    <Setter Property="Text" Value="In Stock" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsAvailable}" Value="False">
                                                    <Setter Property="Text" Value="Sold Out" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>

                                    <!-- Row 1, Col 0-1: ProductName -->
                                    <Label Grid.Row="1"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding ProductName}"
                                           FontFamily="QuicksandBold"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#0A0A0A"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation"
                                           VerticalOptions="Start" />

                                    <!-- Row 2, Col 0-1: Stock count -->
                                    <Label Grid.Row="2"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding StockQuantity, StringFormat='Stock: {0}'}"
                                           FontFamily="InterRegular"
                                           FontSize="11"
                                           TextColor="#52525B"
                                           VerticalOptions="Center" />

                                    <!-- Row 3, Col 0-1: Full unclipped Selling Price -->
                                    <Label Grid.Row="3"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding SellingPrice, StringFormat='₱{0:F2}'}"
                                           FontFamily="QuicksandBold"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#0A0A0A"
                                           VerticalOptions="End" />
                                </Grid>

                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Recent Orders & Void Order Drawer -->
                <Border Grid.Row="3"
                        Style="{StaticResource CardSurface}"
                        Padding="14"
                        IsVisible="{Binding IsOrderHistoryPanelVisible}">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="RECENT ORDERS &amp; VOID"
                                       FontFamily="QuicksandBold"
                                       FontSize="16"
                                       TextColor="{StaticResource PrimaryBlack}" />
                                <Label Text="Voiding requires an authorized Security PIN."
                                       Style="{StaticResource MutedCaption}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="Back to Menu"
                                    Style="{StaticResource PrimaryBlackButton}"
                                    HeightRequest="36"
                                    Padding="12,0"
                                    FontSize="12"
                                    Command="{Binding ToggleOrderHistoryPanelCommand}" />
                        </Grid>

                        <CollectionView Grid.Row="1"
                                        ItemsSource="{Binding RecentCompletedAndVoidedOrders}"
                                        ItemSizingStrategy="MeasureFirstItem"
                                        SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Order">
                                    <Border BackgroundColor="{StaticResource OffWhiteCream}"
                                            Stroke="{StaticResource BorderGray}"
                                            Padding="12,10">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding ReceiptNumber}"
                                                       FontFamily="QuicksandBold"
                                                       FontSize="13"
                                                       TextColor="{StaticResource PrimaryBlack}" />
                                                <Label Text="{Binding ItemsSummary}"
                                                       Style="{StaticResource MutedCaption}"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}"
                                                       FontFamily="QuicksandBold"
                                                       FontSize="13"
                                                       TextColor="{StaticResource PrimaryBlack}" />
                                            </VerticalStackLayout>

                                            <Button Grid.Column="1"
                                                    Text="Receipt"
                                                    Style="{StaticResource OutlineSecondaryButton}"
                                                    HeightRequest="34"
                                                    Padding="10,0"
                                                    FontSize="11"
                                                    Command="{Binding Source={x:Reference PointOfSaleRootPage}, Path=BindingContext.ViewOrderReceiptCommand}"
                                                    CommandParameter="{Binding .}" />

                                            <Button Grid.Column="2"
                                                    Text="Void"
                                                    Style="{StaticResource DangerButton}"
                                                    HeightRequest="34"
                                                    Padding="10,0"
                                                    FontSize="11"
                                                    IsEnabled="{Binding IsVoided, Converter={StaticResource InverseBoolConverter}}"
                                                    Command="{Binding Source={x:Reference PointOfSaleRootPage}, Path=BindingContext.VoidOrderTransactionCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Border>
            </Grid>

            <!-- Tablet / Desktop Split-Screen Order Cart (Hidden on Phone) -->
            <Border Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource CardSurface}"
                    Padding="18"
                    IsVisible="{OnIdiom Phone=False, Tablet=True, Desktop=True}">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">

                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="LIVE ORDER CART"
                                   FontFamily="QuicksandBold"
                                   FontSize="18"
                                   TextColor="{StaticResource PrimaryBlack}" />
                            <Label Text="{Binding Cart.TotalQuantity, StringFormat='{0} items in current order'}"
                                   Style="{StaticResource MutedCaption}" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="Clear"
                                Style="{StaticResource OutlineSecondaryButton}"
                                HeightRequest="34"
                                Padding="12,0"
                                FontSize="12"
                                Command="{Binding ClearCurrentCartCommand}" />
                    </Grid>

                    <VerticalStackLayout Grid.Row="1" Spacing="8">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Grid.Column="0"
                                    Text="Dine-In"
                                    HeightRequest="38"
                                    CornerRadius="12"
                                    Command="{Binding SelectOrderTypeCommand}"
                                    CommandParameter="Dine-In">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsDineInSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryBlack}" />
                                        <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsDineInSelected}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{StaticResource OffWhiteCream}" />
                                        <Setter Property="TextColor" Value="{StaticResource PrimaryBlack}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Grid.Column="1"
                                    Text="Take-Out"
                                    HeightRequest="38"
                                    CornerRadius="12"
                                    Command="{Binding SelectOrderTypeCommand}"
                                    CommandParameter="Take-Out">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsTakeOutSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryBlack}" />
                                        <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsTakeOutSelected}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{StaticResource OffWhiteCream}" />
                                        <Setter Property="TextColor" Value="{StaticResource PrimaryBlack}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>

                        <Border Style="{StaticResource InputFieldBorder}" Padding="12,2">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding HasCustomerOrTableError}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource StatusDanger}" />
                                    <Setter Property="StrokeThickness" Value="1.5" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Entry Text="{Binding CustomerOrTableLabel}"
                                   Placeholder="Customer Name or Table Number (min 2 chars)"
                                   BackgroundColor="Transparent"
                                   FontSize="13" />
                        </Border>
                        <Label Text="{Binding CustomerOrTableError}" Style="{StaticResource InlineErrorLabel}" IsVisible="{Binding HasCustomerOrTableError}" />
                    </VerticalStackLayout>

                    <CollectionView Grid.Row="2"
                                    ItemsSource="{Binding Cart.OrderItems}"
                                    ItemSizingStrategy="MeasureFirstItem"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="20">
                                <Border BackgroundColor="{StaticResource PrimaryBlack}" WidthRequest="44" HeightRequest="44" StrokeThickness="0" HorizontalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                                    <Image Source="point_of_sale.png" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="Cart is empty" FontFamily="QuicksandBold" FontSize="15" HorizontalOptions="Center" />
                                <Label Text="Tap any menu card on the left to add items." Style="{StaticResource MutedCaption}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:OrderCartItem">
                                <Border BackgroundColor="{StaticResource OffWhiteCream}"
                                        Stroke="{StaticResource BorderGray}"
                                        Padding="12,10">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Product.ProductName}"
                                                   FontFamily="QuicksandBold"
                                                   FontSize="14"
                                                   TextColor="{StaticResource PrimaryBlack}" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding LineSubtotal, Converter={StaticResource CurrencyConverter}}"
                                                   FontFamily="QuicksandBold"
                                                   FontSize="14"
                                                   TextColor="{StaticResource PrimaryBlack}" />
                                        </Grid>

                                        <Label Text="{Binding ModifierSummary}"
                                               Style="{StaticResource MutedCaption}"
                                               IsVisible="{Binding ModifierSummary, Converter={StaticResource StringNotEmptyConverter}}" />

                                        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                            <Button Grid.Column="0"
                                                    Text="-"
                                                    Style="{StaticResource OutlineSecondaryButton}"
                                                    WidthRequest="34"
                                                    HeightRequest="32"
                                                    Padding="0"
                                                    Command="{Binding Source={x:Reference PointOfSaleRootPage}, Path=BindingContext.DecrementCartItemCommand}"
                                                    CommandParameter="{Binding .}" />

                                            <Label Grid.Column="1"
                                                   Text="{Binding Quantity}"
                                                   FontFamily="QuicksandBold"
                                                   FontSize="14"
                                                   WidthRequest="28"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalOptions="Center" />

                                            <Button Grid.Column="2"
                                                    Text="+"
                                                    Style="{StaticResource PrimaryBlackButton}"
                                                    WidthRequest="34"
                                                    HeightRequest="32"
                                                    Padding="0"
                                                    Command="{Binding Source={x:Reference PointOfSaleRootPage}, Path=BindingContext.IncrementCartItemCommand}"
                                                    CommandParameter="{Binding .}" />

                                            <Button Grid.Column="3"
                                                    Text="Note"
                                                    Style="{StaticResource OutlineSecondaryButton}"
                                                    HeightRequest="32"
                                                    Padding="10,0"
                                                    FontSize="11"
                                                    HorizontalOptions="End"
                                                    Command="{Binding Source={x:Reference PointOfSaleRootPage}, Path=BindingContext.EditItemNotesCommand}"
                                                    CommandParameter="{Binding .}" />

                                            <Button Grid.Column="4"
                                                    Text="Remove"
                                                    Style="{StaticResource DangerButton}"
                                                    HeightRequest="32"
                                                    Padding="10,0"
                                                    FontSize="11"
                                                    Command="{Binding Source={x:Reference PointOfSaleRootPage}, Path=BindingContext.RemoveCartItemCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>

                                        <Label Text="{Binding PreparationNotes, StringFormat='Note: {0}'}"
                                               Style="{StaticResource MutedCaption}"
                                               IsVisible="{Binding PreparationNotes, Converter={StaticResource StringNotEmptyConverter}}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <VerticalStackLayout Grid.Row="3" Spacing="10">
                        <BoxView HeightRequest="1" Color="{StaticResource BorderGray}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Subtotal Amount" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource MutedText}" />
                            <Label Grid.Column="1"
                                   Text="{Binding Cart.SubtotalAmount, Converter={StaticResource CurrencyConverter}}"
                                   FontFamily="QuicksandBold"
                                   FontSize="20"
                                   TextColor="{StaticResource PrimaryBlack}" />
                        </Grid>

                        <Button Text="Proceed to Multi-Payment Checkout"
                                Style="{StaticResource PrimaryBlackButton}"
                                HeightRequest="52"
                                IsEnabled="{Binding CanProceedToCheckout}"
                                Command="{Binding ProceedToCheckoutCommand}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Row 2: Phone Floating Bottom Cart Summary Bar -->
            <Border Grid.Row="2"
                    Grid.Column="0"
                    Style="{StaticResource DarkCardSurface}"
                    Padding="14,10"
                    IsVisible="{OnIdiom Phone=True, Tablet=False, Desktop=False}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Cart.TotalQuantity, StringFormat='{0} Items in Cart'}"
                               FontFamily="InterSemiBold"
                               FontSize="12"
                               TextColor="#D4D4D8" />
                        <Label Text="{Binding Cart.SubtotalAmount, Converter={StaticResource CurrencyConverter}}"
                               FontFamily="QuicksandBold"
                               FontSize="19"
                               TextColor="{StaticResource PureWhite}" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="Checkout"
                            BackgroundColor="{StaticResource PureWhite}"
                            TextColor="{StaticResource PrimaryBlack}"
                            FontFamily="QuicksandBold"
                            CornerRadius="14"
                            HeightRequest="44"
                            Padding="20,0"
                            Command="{Binding ProceedToCheckoutCommand}" />
                </Grid>
            </Border>

        </Grid>

        <!-- Barista Drink Customization Bottom Sheet / Modal Overlay -->
        <Grid x:Name="DrinkModifierBackdrop"
              BackgroundColor="#73000000"
              IsVisible="{Binding IsDrinkModifierModalVisible}"
              Padding="20">
            <Border x:Name="DrinkModifierSheet"
                    Style="{StaticResource CardSurface}"
                    MaximumWidthRequest="500"
                    MinimumWidthRequest="320"
                    Padding="24"
                    VerticalOptions="End"
                    HorizontalOptions="Center">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding CustomizingProduct.ProductName}" FontFamily="QuicksandBold" FontSize="20" TextColor="{StaticResource PrimaryBlack}" />
                            <Label Text="Customize cup size, ice, sweetness, and add-ons" Style="{StaticResource MutedCaption}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding CustomizedUnitPrice, Converter={StaticResource CurrencyConverter}}"
                               FontFamily="QuicksandBold"
                               FontSize="20"
                               TextColor="{StaticResource PrimaryBlack}"
                               VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Cup Size" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource PrimaryBlack}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Regular (+₱0)" HeightRequest="40" CornerRadius="12" Command="{Binding SelectCupSizeCommand}" CommandParameter="Regular">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsRegularSizeSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryBlack}" />
                                        <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsRegularSizeSelected}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{StaticResource OffWhiteCream}" />
                                        <Setter Property="TextColor" Value="{StaticResource PrimaryBlack}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="1" Text="Large (+₱25)" HeightRequest="40" CornerRadius="12" Command="{Binding SelectCupSizeCommand}" CommandParameter="Large">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsLargeSizeSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryBlack}" />
                                        <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsLargeSizeSelected}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{StaticResource OffWhiteCream}" />
                                        <Setter Property="TextColor" Value="{StaticResource PrimaryBlack}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Ice Level" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource PrimaryBlack}" />
                            <Border Style="{StaticResource InputFieldBorder}">
                                <Picker ItemsSource="{Binding IceLevelOptions}" SelectedItem="{Binding SelectedIceLevel}" TextColor="{StaticResource PrimaryBlack}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Sweetness" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource PrimaryBlack}" />
                            <Border Style="{StaticResource InputFieldBorder}">
                                <Picker ItemsSource="{Binding SweetnessOptions}" SelectedItem="{Binding SelectedSweetnessLevel}" TextColor="{StaticResource PrimaryBlack}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Border BackgroundColor="{StaticResource OffWhiteCream}" Stroke="{StaticResource BorderGray}" Padding="12,10">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="ADD-ONS" FontFamily="QuicksandBold" FontSize="12" TextColor="{StaticResource PrimaryBlack}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Extra Espresso Shot (+₱30)" FontSize="13" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding HasExtraShotAddOn}" OnColor="{StaticResource PrimaryBlack}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Oat Milk Upgrade (+₱35)" FontSize="13" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding HasOatMilkAddOn}" OnColor="{StaticResource PrimaryBlack}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Caramel Drizzle (+₱20)" FontSize="13" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding HasCaramelDrizzleAddOn}" OnColor="{StaticResource PrimaryBlack}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource InputFieldBorder}">
                        <Entry Text="{Binding CustomDrinkNotes}" Placeholder="Optional barista notes (e.g. extra hot)" BackgroundColor="Transparent" />
                    </Border>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Text="Cancel" Style="{StaticResource OutlineSecondaryButton}" Command="{Binding CloseDrinkModifierModalCommand}" />
                        <Button Grid.Column="1" Text="Add Customized Drink" Style="{StaticResource PrimaryBlackButton}" Command="{Binding ConfirmCustomizedDrinkCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
