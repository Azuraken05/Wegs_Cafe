<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Wegs_Cafe.ViewModels"
             x:Class="Wegs_Cafe.Views.ProductEditPage"
             x:DataType="vm:ProductEditViewModel"
             Title="{Binding PageTitle}"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PureWhite}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14" MaximumWidthRequest="560" HorizontalOptions="Center">

            <!-- Photo -->
            <Border Style="{StaticResource CreamCard}" HorizontalOptions="Center" WidthRequest="180" HeightRequest="180" Padding="0">
                <Grid>
                    <Label Text="☕" FontSize="56" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}" Aspect="AspectFill" />
                </Grid>
            </Border>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Take photo" Style="{StaticResource SecondaryButton}" HeightRequest="44" Command="{Binding TakePhotoCommand}" />
                <Button Grid.Column="1" Text="Choose photo" Style="{StaticResource SecondaryButton}" HeightRequest="44" Command="{Binding ChoosePhotoCommand}" />
            </Grid>
            <Button Text="Remove photo" Style="{StaticResource SecondaryButton}" HeightRequest="36" FontSize="12"
                    Command="{Binding RemovePhotoCommand}"
                    IsVisible="{Binding ImagePath, Converter={StaticResource StringNotEmptyConverter}}" />

            <!-- Details -->
            <Label Text="Name" Style="{StaticResource MutedLabel}" />
            <Border Style="{StaticResource InputBorder}"><Entry Style="{StaticResource BareEntry}" Placeholder="e.g. Iced Latte" Text="{Binding Name}" /></Border>

            <Label Text="SKU" Style="{StaticResource MutedLabel}" />
            <Border Style="{StaticResource InputBorder}"><Entry Style="{StaticResource BareEntry}" Placeholder="e.g. COF-001" Text="{Binding Sku}" /></Border>

            <Label Text="Category" Style="{StaticResource MutedLabel}" />
            <Border Style="{StaticResource InputBorder}">
                <Picker TextColor="{StaticResource PrimaryBlack}" FontFamily="Body" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" />
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Selling price (₱)" Style="{StaticResource MutedLabel}" />
                    <Border Style="{StaticResource InputBorder}"><Entry Style="{StaticResource BareEntry}" Keyboard="Numeric" Placeholder="0.00" Text="{Binding PriceText}" /></Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="6" IsVisible="{Binding ShowCost}">
                    <Label Text="Cost price (₱)" Style="{StaticResource MutedLabel}" />
                    <Border Style="{StaticResource InputBorder}"><Entry Style="{StaticResource BareEntry}" Keyboard="Numeric" Placeholder="0.00" Text="{Binding CostText}" /></Border>
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowInitialStock}">
                    <Label Text="Initial stock" Style="{StaticResource MutedLabel}" />
                    <Border Style="{StaticResource InputBorder}"><Entry Style="{StaticResource BareEntry}" Keyboard="Numeric" Text="{Binding StockText}" /></Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Label Text="Low-stock threshold" Style="{StaticResource MutedLabel}" />
                    <Border Style="{StaticResource InputBorder}"><Entry Style="{StaticResource BareEntry}" Keyboard="Numeric" Text="{Binding ThresholdText}" /></Border>
                </VerticalStackLayout>
            </Grid>

            <Label Text="Unit" Style="{StaticResource MutedLabel}" />
            <Border Style="{StaticResource InputBorder}">
                <Picker TextColor="{StaticResource PrimaryBlack}" FontFamily="Body" ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" />
            </Border>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Available for sale (shown in POS)" Style="{StaticResource BodyLabel}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding IsAvailable}" OnColor="{StaticResource PrimaryBlack}" />
            </Grid>

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource AlertDanger}" FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button Text="Save product" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
            <Button Text="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
