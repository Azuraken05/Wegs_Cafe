<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Wegs_Cafe.ViewModels"
             xmlns:models="clr-namespace:Wegs_Cafe.Models"
             x:Class="Wegs_Cafe.Views.InventoryManagementPage"
             x:DataType="vm:InventoryManagementViewModel"
             x:Name="InventoryPageRoot"
             Title="{Binding PageTitle}"
             BackgroundColor="{StaticResource PureWhite}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout x:Name="InventoryContainer" Padding="14,16" Spacing="14">

                <!-- Summary KPI Strip (Compact 3-Column Mobile Layout) -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border Grid.Column="0"
                            Style="{StaticResource CardSurface}"
                            Padding="12,10"
                            Shadow="{x:Null}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="MENU ITEMS"
                                   FontFamily="InterSemiBold"
                                   FontSize="10"
                                   TextColor="{StaticResource MutedText}"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding TotalProductCount}"
                                   FontFamily="QuicksandBold"
                                   FontSize="24"
                                   TextColor="{StaticResource PrimaryBlack}" />
                            <Label Text="Active SKUs"
                                   FontSize="11"
                                   TextColor="{StaticResource MutedText}"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource CardSurface}"
                            Padding="12,10"
                            Shadow="{x:Null}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="LOW STOCK"
                                   FontFamily="InterSemiBold"
                                   FontSize="10"
                                   TextColor="{StaticResource StatusWarning}"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding LowStockCount}"
                                   FontFamily="QuicksandBold"
                                   FontSize="24"
                                   TextColor="{StaticResource StatusWarning}" />
                            <Label Text="Below threshold"
                                   FontSize="11"
                                   TextColor="{StaticResource MutedText}"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource CardSurface}"
                            Padding="12,10"
                            Shadow="{x:Null}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="OUT OF STOCK"
                                   FontFamily="InterSemiBold"
                                   FontSize="10"
                                   TextColor="{StaticResource StatusDanger}"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding OutOfStockCount}"
                                   FontFamily="QuicksandBold"
                                   FontSize="24"
                                   TextColor="{StaticResource StatusDanger}" />
                            <Label Text="Needs restock"
                                   FontSize="11"
                                   TextColor="{StaticResource MutedText}"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Stock Controls & Filter Bar -->
                <Border Style="{StaticResource CardSurface}" Padding="14" Shadow="{x:Null}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="REAL-TIME STOCK LEVELS"
                               FontFamily="QuicksandBold"
                               FontSize="16"
                               TextColor="{StaticResource PrimaryBlack}" />

                        <!-- Equal-Width 3-Tab Filter Strip (Fits All Mobile Screens Without Clipping) -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button Grid.Column="0"
                                    Text="All Items"
                                    HeightRequest="36"
                                    Padding="6,0"
                                    FontSize="12"
                                    FontFamily="QuicksandBold"
                                    CornerRadius="18"
                                    Command="{Binding SelectStockFilterCommand}"
                                    CommandParameter="All">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsAllFilterSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryBlack}" />
                                        <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsAllFilterSelected}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{StaticResource OffWhiteCream}" />
                                        <Setter Property="TextColor" Value="{StaticResource PrimaryBlack}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Grid.Column="1"
                                    Text="Low Stock"
                                    HeightRequest="36"
                                    Padding="6,0"
                                    FontSize="12"
                                    FontFamily="QuicksandBold"
                                    CornerRadius="18"
                                    Command="{Binding SelectStockFilterCommand}"
                                    CommandParameter="Low Stock">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsLowStockFilterSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource StatusWarning}" />
                                        <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsLowStockFilterSelected}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{StaticResource OffWhiteCream}" />
                                        <Setter Property="TextColor" Value="{StaticResource PrimaryBlack}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Grid.Column="2"
                                    Text="Out of Stock"
                                    HeightRequest="36"
                                    Padding="6,0"
                                    FontSize="12"
                                    FontFamily="QuicksandBold"
                                    CornerRadius="18"
                                    Command="{Binding SelectStockFilterCommand}"
                                    CommandParameter="Out of Stock">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsOutOfStockFilterSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource StatusDanger}" />
                                        <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsOutOfStockFilterSelected}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{StaticResource OffWhiteCream}" />
                                        <Setter Property="TextColor" Value="{StaticResource PrimaryBlack}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>

                        <!-- Search Filter Bar -->
                        <Border Style="{StaticResource SearchPillBorder}" Padding="10,4" Shadow="{x:Null}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Grid.Column="0"
                                        BackgroundColor="{StaticResource PrimaryBlack}"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        StrokeThickness="0"
                                        VerticalOptions="Center"
                                        Shadow="{x:Null}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                    <Image Source="search.png"
                                           WidthRequest="15"
                                           HeightRequest="15"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <Entry Grid.Column="1"
                                       Text="{Binding SearchQuery}"
                                       Placeholder="Search product name, SKU, or category..."
                                       FontSize="13"
                                       BackgroundColor="Transparent"
                                       TextColor="{StaticResource PrimaryBlack}" />
                            </Grid>
                        </Border>

                        <!-- Inventory Product List (2-Row Mobile-Responsive Card per Product) -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding FilteredProducts}"
                                             Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Product">
                                    <Border BackgroundColor="{StaticResource OffWhiteCream}"
                                            Stroke="{StaticResource BorderGray}"
                                            StrokeThickness="1"
                                            Padding="14,12"
                                            Shadow="{x:Null}">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                        <VerticalStackLayout Spacing="10">
                                            <!-- Top Row: Product Name + SKU/Category on Left, Status Pill on Right -->
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Start">
                                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                    <Label Text="{Binding ProductName}"
                                                           FontFamily="QuicksandBold"
                                                           FontSize="15"
                                                           TextColor="{StaticResource PrimaryBlack}"
                                                           LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding StockKeepingUnitAndCategory}"
                                                           FontSize="12"
                                                           TextColor="{StaticResource MutedText}"
                                                           LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>

                                                <Border Grid.Column="1"
                                                        BackgroundColor="{StaticResource StatusSuccess}"
                                                        Padding="10,4"
                                                        StrokeThickness="0"
                                                        VerticalOptions="Start"
                                                        Shadow="{x:Null}">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsLowStock}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource StatusWarning}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsOutOfStock}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource StatusDanger}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Label Text="{Binding StockStatusText}"
                                                           FontFamily="QuicksandBold"
                                                           FontSize="11"
                                                           TextColor="{StaticResource PureWhite}" />
                                                </Border>
                                            </Grid>

                                            <!-- Bottom Row: Current Stock Count on Left, Restock Button on Right -->
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                <Label Grid.Column="0"
                                                       Text="{Binding StockDisplayText, StringFormat='Stock: {0}'}"
                                                       FontFamily="InterSemiBold"
                                                       FontSize="13"
                                                       TextColor="{StaticResource PrimaryBlack}"
                                                       VerticalOptions="Center"
                                                       LineBreakMode="TailTruncation" />

                                                <Button Grid.Column="1"
                                                        Text="Restock / Adjust"
                                                        Style="{StaticResource PrimaryBlackButton}"
                                                        HeightRequest="34"
                                                        Padding="14,0"
                                                        CornerRadius="10"
                                                        FontSize="12"
                                                        IsVisible="{Binding Source={x:Reference InventoryPageRoot}, Path=BindingContext.CanRestockInventory}"
                                                        Command="{Binding Source={x:Reference InventoryPageRoot}, Path=BindingContext.OpenAdjustmentModalCommand}"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Inventory Movement Ledger -->
                <Border Style="{StaticResource CardSurface}" Padding="14" Shadow="{x:Null}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="INVENTORY MOVEMENT LOGS"
                               FontFamily="QuicksandBold"
                               FontSize="15"
                               TextColor="{StaticResource PrimaryBlack}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentInventoryLogs}"
                                             Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:InventoryLog">
                                    <Border BackgroundColor="{StaticResource OffWhiteCream}"
                                            Stroke="{StaticResource BorderGray}"
                                            StrokeThickness="1"
                                            Padding="12,10"
                                            Shadow="{x:Null}">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <VerticalStackLayout Spacing="6">
                                            <!-- Top Row: Product Name + Movement Type on Left, Quantity Delta Badge on Right -->
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                    <Label Text="{Binding ProductName}"
                                                           FontFamily="QuicksandBold"
                                                           FontSize="14"
                                                           TextColor="{StaticResource PrimaryBlack}"
                                                           LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding MovementType}"
                                                           FontFamily="InterSemiBold"
                                                           FontSize="12"
                                                           TextColor="{StaticResource MutedText}" />
                                                </VerticalStackLayout>

                                                <Border Grid.Column="1"
                                                        BackgroundColor="{StaticResource PureWhite}"
                                                        Stroke="{StaticResource BorderGray}"
                                                        Padding="10,4"
                                                        VerticalOptions="Center"
                                                        Shadow="{x:Null}">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                    <Label Text="{Binding QuantityChangedDisplay}"
                                                           FontFamily="QuicksandBold"
                                                           FontSize="13"
                                                           TextColor="{StaticResource PrimaryBlack}" />
                                                </Border>
                                            </Grid>

                                            <!-- Optional Notes Row -->
                                            <Label Text="{Binding Remarks, StringFormat='Notes: {0}'}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource MutedText}"
                                                   IsVisible="{Binding Remarks, Converter={StaticResource StringNotEmptyConverter}}" />

                                            <!-- Bottom Row: Operator Name on Left, Timestamp on Right -->
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label Grid.Column="0"
                                                       Text="{Binding PerformedByName, StringFormat='By: {0}'}"
                                                       FontFamily="InterSemiBold"
                                                       FontSize="11"
                                                       TextColor="{StaticResource MutedText}"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding RecordedAtLocalDisplay}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource MutedText}" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Restock / Adjust Stock Modal Overlay -->
        <Grid BackgroundColor="#73000000"
              IsVisible="{Binding IsAdjustmentModalVisible}"
              Padding="16">
            <Border Style="{StaticResource CardSurface}"
                    MaximumWidthRequest="480"
                    Padding="20"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    Shadow="{x:Null}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="RESTOCK / ADJUST INVENTORY STOCK"
                           FontFamily="QuicksandBold"
                           FontSize="17"
                           TextColor="{StaticResource PrimaryBlack}" />

                    <Label Text="{Binding SelectedAdjustmentProduct.ProductName, StringFormat='Product: {0}'}"
                           FontFamily="InterSemiBold"
                           FontSize="14"
                           TextColor="{StaticResource PrimaryBlack}" />

                    <Label Text="{Binding SelectedAdjustmentProduct.StockDisplayText, StringFormat='Current Stock: {0}'}"
                           Style="{StaticResource MutedCaption}" />

                    <!-- Movement Type -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Movement Type" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource PrimaryBlack}" />
                        <Border Style="{StaticResource InputFieldBorder}" Shadow="{x:Null}">
                            <Picker ItemsSource="{Binding MovementTypeOptions}"
                                    SelectedItem="{Binding SelectedMovementType}"
                                    TextColor="{StaticResource PrimaryBlack}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Quantity Change -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Quantity Change (+ to add, - to deduct)" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource PrimaryBlack}" />
                        <Border Style="{StaticResource InputFieldBorder}" Shadow="{x:Null}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding HasQuantityChangeError}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource StatusDanger}" />
                                    <Setter Property="StrokeThickness" Value="1.5" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Entry Text="{Binding QuantityChangeText}" Keyboard="Numeric" Placeholder="e.g. 20 or -2" BackgroundColor="Transparent" />
                        </Border>
                        <Label Text="{Binding QuantityChangeError}" Style="{StaticResource InlineErrorLabel}" IsVisible="{Binding HasQuantityChangeError}" />
                    </VerticalStackLayout>

                    <!-- Reason / Notes -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Reason / Notes (min 5 chars for Spoilage / Correction)" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource PrimaryBlack}" />
                        <Border Style="{StaticResource InputFieldBorder}" Shadow="{x:Null}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding HasAdjustmentRemarksError}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource StatusDanger}" />
                                    <Setter Property="StrokeThickness" Value="1.5" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Entry Text="{Binding AdjustmentRemarks}" Placeholder="e.g. Morning delivery or expired milk batch" BackgroundColor="Transparent" />
                        </Border>
                        <Label Text="{Binding AdjustmentRemarksError}" Style="{StaticResource InlineErrorLabel}" IsVisible="{Binding HasAdjustmentRemarksError}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,6,0,0">
                        <Button Grid.Column="0"
                                Text="Cancel"
                                Style="{StaticResource OutlineSecondaryButton}"
                                Command="{Binding CloseAdjustmentModalCommand}" />
                        <Button Grid.Column="1"
                                Text="Save Stock Adjustment"
                                Style="{StaticResource PrimaryBlackButton}"
                                IsEnabled="{Binding CanSubmitAdjustment}"
                                Command="{Binding SubmitStockAdjustmentCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
