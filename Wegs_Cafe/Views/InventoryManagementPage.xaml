<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Wegs_Cafe.ViewModels"
             xmlns:models="clr-namespace:Wegs_Cafe.Models"
             x:Class="Wegs_Cafe.Views.InventoryManagementPage"
             x:DataType="vm:InventoryManagementViewModel"
             x:Name="InventoryPageRoot"
             Title="{Binding PageTitle}"
             BackgroundColor="{StaticResource PureWhite}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout x:Name="InventoryContainer" Padding="14,16" Spacing="14">

                <!-- Summary KPI Strip (Compact 3-Column Mobile Layout) -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border Grid.Column="0"
                            Style="{StaticResource CardSurface}"
                            Padding="12,10"
                            Shadow="{x:Null}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="RAW INGREDIENTS"
                                   FontFamily="InterSemiBold"
                                   FontSize="10"
                                   TextColor="{StaticResource MutedText}"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding TotalIngredientCount}"
                                   FontFamily="QuicksandBold"
                                   FontSize="24"
                                   TextColor="{StaticResource PrimaryBlack}" />
                            <Label Text="Active SKUs"
                                   FontSize="11"
                                   TextColor="{StaticResource MutedText}"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource CardSurface}"
                            Padding="12,10"
                            Shadow="{x:Null}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="LOW STOCK"
                                   FontFamily="InterSemiBold"
                                   FontSize="10"
                                   TextColor="{StaticResource StatusWarning}"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding LowStockCount}"
                                   FontFamily="QuicksandBold"
                                   FontSize="24"
                                   TextColor="{StaticResource StatusWarning}" />
                            <Label Text="At/below limit"
                                   FontSize="11"
                                   TextColor="{StaticResource MutedText}"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource CardSurface}"
                            Padding="12,10"
                            Shadow="{x:Null}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="OUT OF STOCK"
                                   FontFamily="InterSemiBold"
                                   FontSize="10"
                                   TextColor="{StaticResource StatusDanger}"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding OutOfStockCount}"
                                   FontFamily="QuicksandBold"
                                   FontSize="24"
                                   TextColor="{StaticResource StatusDanger}" />
                            <Label Text="Needs restock"
                                   FontSize="11"
                                   TextColor="{StaticResource MutedText}"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Stock Controls & Filter Bar -->
                <Border Style="{StaticResource CardSurface}" Padding="14" Shadow="{x:Null}">
                    <VerticalStackLayout Spacing="12">
                        <!-- Header with Title + New Ingredient Button -->
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="RAW INGREDIENTS LEDGER"
                                   FontFamily="QuicksandBold"
                                   FontSize="16"
                                   TextColor="{StaticResource PrimaryBlack}"
                                   VerticalOptions="Center" />

                            <Button Grid.Column="1"
                                    Text="+ Add Ingredient"
                                    HeightRequest="34"
                                    Padding="12,0"
                                    FontSize="12"
                                    FontFamily="QuicksandBold"
                                    CornerRadius="8"
                                    Style="{StaticResource PrimaryBlackButton}"
                                    IsVisible="{Binding CanRegisterIngredients}"
                                    Command="{Binding OpenRegistrationModalCommand}" />
                        </Grid>

                        <!-- Equal-Width 3-Tab Filter Strip -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button Grid.Column="0"
                                    Text="All Items"
                                    HeightRequest="36"
                                    Padding="6,0"
                                    FontSize="12"
                                    FontFamily="QuicksandBold"
                                    CornerRadius="18"
                                    Command="{Binding SelectStockFilterCommand}"
                                    CommandParameter="All">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsAllFilterSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryBlack}" />
                                        <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsAllFilterSelected}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{StaticResource OffWhiteCream}" />
                                        <Setter Property="TextColor" Value="{StaticResource PrimaryBlack}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Grid.Column="1"
                                    Text="Low Stock"
                                    HeightRequest="36"
                                    Padding="6,0"
                                    FontSize="12"
                                    FontFamily="QuicksandBold"
                                    CornerRadius="18"
                                    Command="{Binding SelectStockFilterCommand}"
                                    CommandParameter="Low Stock">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsLowStockFilterSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource StatusWarning}" />
                                        <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsLowStockFilterSelected}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{StaticResource OffWhiteCream}" />
                                        <Setter Property="TextColor" Value="{StaticResource PrimaryBlack}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Grid.Column="2"
                                    Text="Out of Stock"
                                    HeightRequest="36"
                                    Padding="6,0"
                                    FontSize="12"
                                    FontFamily="QuicksandBold"
                                    CornerRadius="18"
                                    Command="{Binding SelectStockFilterCommand}"
                                    CommandParameter="Out of Stock">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsOutOfStockFilterSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource StatusDanger}" />
                                        <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsOutOfStockFilterSelected}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{StaticResource OffWhiteCream}" />
                                        <Setter Property="TextColor" Value="{StaticResource PrimaryBlack}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>

                        <!-- Search Filter Bar -->
                        <Border Style="{StaticResource SearchPillBorder}" Padding="10,4" Shadow="{x:Null}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Grid.Column="0"
                                        BackgroundColor="{StaticResource PrimaryBlack}"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        StrokeThickness="0"
                                        VerticalOptions="Center"
                                        Shadow="{x:Null}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                    <Image Source="search.png"
                                           WidthRequest="15"
                                           HeightRequest="15"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <Entry Grid.Column="1"
                                       Text="{Binding SearchQuery}"
                                       Placeholder="Search raw ingredients, SKU, category..."
                                       FontSize="13"
                                       BackgroundColor="Transparent"
                                       TextColor="{StaticResource PrimaryBlack}" />
                            </Grid>
                        </Border>

                        <!-- Ingredients List -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding FilteredIngredients}"
                                             Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Ingredient">
                                    <Border BackgroundColor="{StaticResource OffWhiteCream}"
                                            Stroke="{StaticResource BorderGray}"
                                            StrokeThickness="1"
                                            Padding="14,12"
                                            Shadow="{x:Null}">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                        <VerticalStackLayout Spacing="8">
                                            <!-- Top Row: Ingredient Name + Status Badge -->
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Start">
                                                <Label Grid.Column="0"
                                                       Text="{Binding IngredientName}"
                                                       FontFamily="QuicksandBold"
                                                       FontSize="15"
                                                       TextColor="{StaticResource PrimaryBlack}"
                                                       LineBreakMode="TailTruncation" />

                                                <Border Grid.Column="1"
                                                        BackgroundColor="{StaticResource StatusSuccess}"
                                                        Padding="10,3"
                                                        StrokeThickness="0"
                                                        VerticalOptions="Start"
                                                        Shadow="{x:Null}">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsLowStock}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource StatusWarning}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsOutOfStock}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource StatusDanger}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Label Text="{Binding StockStatusText}"
                                                           FontFamily="QuicksandBold"
                                                           FontSize="11"
                                                           TextColor="{StaticResource PureWhite}" />
                                                </Border>
                                            </Grid>

                                            <!-- Middle Row: SKU & Category + Unit Cost -->
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <Label Grid.Column="0"
                                                       Text="{Binding StockKeepingUnitAndCategory}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource MutedText}"
                                                       LineBreakMode="TailTruncation" />

                                                <Label Grid.Column="1"
                                                       Text="{Binding UnitCost, StringFormat='Cost: ₱{0:N2}'}"
                                                       FontFamily="InterSemiBold"
                                                       FontSize="12"
                                                       TextColor="{StaticResource PrimaryBlack}" />
                                            </Grid>

                                            <!-- Bottom Row: Current Stock & Total Cost on Left, Action Buttons on Right -->
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                                <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                                                    <Label Text="{Binding StockDisplayText, StringFormat='Stock: {0}'}"
                                                           FontFamily="QuicksandBold"
                                                           FontSize="14"
                                                           TextColor="{StaticResource PrimaryBlack}" />
                                                    <Label Text="{Binding TotalValuationAtCost, StringFormat='Value: ₱{0:N2}'}"
                                                           FontSize="11"
                                                           TextColor="{StaticResource MutedText}" />
                                                </VerticalStackLayout>

                                                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                                    <Button Text="Waste"
                                                            HeightRequest="32"
                                                            Padding="10,0"
                                                            CornerRadius="8"
                                                            FontSize="11"
                                                            FontFamily="InterSemiBold"
                                                            BackgroundColor="#FEE2E2"
                                                            TextColor="{StaticResource StatusDanger}"
                                                            IsVisible="{Binding Source={x:Reference InventoryPageRoot}, Path=BindingContext.CanRestockInventory}"
                                                            Command="{Binding Source={x:Reference InventoryPageRoot}, Path=BindingContext.OpenSpoilageModalCommand}"
                                                            CommandParameter="{Binding .}" />

                                                    <Button Text="Restock"
                                                            Style="{StaticResource PrimaryBlackButton}"
                                                            HeightRequest="32"
                                                            Padding="12,0"
                                                            CornerRadius="8"
                                                            FontSize="11"
                                                            IsVisible="{Binding Source={x:Reference InventoryPageRoot}, Path=BindingContext.CanRestockInventory}"
                                                            Command="{Binding Source={x:Reference InventoryPageRoot}, Path=BindingContext.OpenAdjustmentModalCommand}"
                                                            CommandParameter="{Binding .}" />
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Smart Bulk-to-Base Restock / Adjustment Modal Overlay -->
        <Grid BackgroundColor="#73000000"
              IsVisible="{Binding IsAdjustmentModalVisible}"
              Padding="16">
            <Border Style="{StaticResource CardSurface}"
                    MaximumWidthRequest="460"
                    Padding="20"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    Shadow="{x:Null}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="RESTOCK / ADJUST RAW INGREDIENT"
                           FontFamily="QuicksandBold"
                           FontSize="16"
                           TextColor="{StaticResource PrimaryBlack}" />

                    <!-- Ingredient Info Banner -->
                    <Border BackgroundColor="{StaticResource OffWhiteCream}"
                            Padding="12,8"
                            StrokeThickness="0"
                            Shadow="{x:Null}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding SelectedAdjustmentIngredient.IngredientName}"
                                       FontFamily="QuicksandBold"
                                       FontSize="14"
                                       TextColor="{StaticResource PrimaryBlack}" />
                                <Label Text="{Binding SelectedAdjustmentIngredient.StockKeepingUnitAndCategory}"
                                       FontSize="11"
                                       TextColor="{StaticResource MutedText}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="{Binding SelectedAdjustmentIngredient.StockDisplayText, StringFormat='Current: {0}'}"
                                   FontFamily="InterSemiBold"
                                   FontSize="12"
                                   TextColor="{StaticResource PrimaryBlack}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Smart Bulk Pack Mode Toggle -->
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                            <Label Text="Use Bulk Pack Multiplier"
                                   FontFamily="InterSemiBold"
                                   FontSize="12"
                                   TextColor="{StaticResource PrimaryBlack}" />
                            <Label Text="{Binding BulkUnitLabel}"
                                   FontSize="11"
                                   TextColor="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding IsBulkMode}"
                                OnColor="{StaticResource PrimaryBlack}"
                                VerticalOptions="Center" />
                    </Grid>

                    <!-- Movement Type -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Movement Type" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource PrimaryBlack}" />
                        <Border Style="{StaticResource InputFieldBorder}" Shadow="{x:Null}">
                            <Picker ItemsSource="{Binding MovementTypeOptions}"
                                    SelectedItem="{Binding SelectedMovementType}"
                                    TextColor="{StaticResource PrimaryBlack}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Quantity Input with Unit Suffix -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Quantity" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource PrimaryBlack}" />
                        <Border Style="{StaticResource InputFieldBorder}" Shadow="{x:Null}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding HasQuantityChangeError}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource StatusDanger}" />
                                    <Setter Property="StrokeThickness" Value="1.5" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Entry Text="{Binding QuantityChangeText}"
                                   Keyboard="Numeric"
                                   Placeholder="e.g. 5 (liters/packs) or 500 (ml/g)"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource PrimaryBlack}" />
                        </Border>
                        <Label Text="{Binding QuantityChangeError}" Style="{StaticResource InlineErrorLabel}" IsVisible="{Binding HasQuantityChangeError}" />
                    </VerticalStackLayout>

                    <!-- Live Conversion Preview Pill -->
                    <Border BackgroundColor="#E0F2FE"
                            Padding="10,6"
                            StrokeThickness="0"
                            Shadow="{x:Null}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                        <Label Text="{Binding RestockPreviewText}"
                               FontFamily="InterSemiBold"
                               FontSize="12"
                               TextColor="#0369A1"
                               HorizontalOptions="Center" />
                    </Border>

                    <!-- Reason / Remarks -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Reason / Remarks (Required for Waste)" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource PrimaryBlack}" />
                        <Border Style="{StaticResource InputFieldBorder}" Shadow="{x:Null}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding HasAdjustmentRemarksError}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource StatusDanger}" />
                                    <Setter Property="StrokeThickness" Value="1.5" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Entry Text="{Binding AdjustmentRemarks}"
                                   Placeholder="e.g. Morning delivery supplier invoice #1029"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource PrimaryBlack}" />
                        </Border>
                        <Label Text="{Binding AdjustmentRemarksError}" Style="{StaticResource InlineErrorLabel}" IsVisible="{Binding HasAdjustmentRemarksError}" />
                    </VerticalStackLayout>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,4,0,0">
                        <Button Grid.Column="0"
                                Text="Cancel"
                                Style="{StaticResource OutlineSecondaryButton}"
                                Command="{Binding CloseAdjustmentModalCommand}" />
                        <Button Grid.Column="1"
                                Text="Apply Adjustment"
                                Style="{StaticResource PrimaryBlackButton}"
                                IsEnabled="{Binding CanSubmitAdjustment}"
                                Command="{Binding SubmitStockAdjustmentCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Register New Ingredient Modal Overlay -->
        <Grid BackgroundColor="#73000000"
              IsVisible="{Binding IsRegistrationModalVisible}"
              Padding="16">
            <Border Style="{StaticResource CardSurface}"
                    MaximumWidthRequest="480"
                    Padding="20"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    Shadow="{x:Null}">
                <ScrollView MaximumHeightRequest="520">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="REGISTER NEW RAW INGREDIENT"
                               FontFamily="QuicksandBold"
                               FontSize="16"
                               TextColor="{StaticResource PrimaryBlack}" />

                        <!-- Name -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Ingredient Name" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource PrimaryBlack}" />
                            <Border Style="{StaticResource InputFieldBorder}" Shadow="{x:Null}">
                                <Entry Text="{Binding NewIngredientName}" Placeholder="e.g. Fresh Milk, Espresso Beans" BackgroundColor="Transparent" TextColor="{StaticResource PrimaryBlack}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- SKU & Category -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="SKU Code" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource PrimaryBlack}" />
                                <Border Style="{StaticResource InputFieldBorder}" Shadow="{x:Null}">
                                    <Entry Text="{Binding NewIngredientSku}" Placeholder="ING-MLK-01" BackgroundColor="Transparent" TextColor="{StaticResource PrimaryBlack}" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Base Unit" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource PrimaryBlack}" />
                                <Border Style="{StaticResource InputFieldBorder}" Shadow="{x:Null}">
                                    <Picker ItemsSource="{Binding MeasurementUnitOptions}"
                                            SelectedItem="{Binding NewMeasurementUnit}"
                                            TextColor="{StaticResource PrimaryBlack}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Category -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Category" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource PrimaryBlack}" />
                            <Border Style="{StaticResource InputFieldBorder}" Shadow="{x:Null}">
                                <Picker ItemsSource="{Binding CategoryOptions}"
                                        SelectedItem="{Binding NewIngredientCategory}"
                                        TextColor="{StaticResource PrimaryBlack}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Initial Stock, Threshold, Unit Cost -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Initial Stock" FontFamily="InterSemiBold" FontSize="11" TextColor="{StaticResource PrimaryBlack}" />
                                <Border Style="{StaticResource InputFieldBorder}" Shadow="{x:Null}">
                                    <Entry Text="{Binding NewCurrentStockText}" Keyboard="Numeric" BackgroundColor="Transparent" TextColor="{StaticResource PrimaryBlack}" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Low Threshold" FontFamily="InterSemiBold" FontSize="11" TextColor="{StaticResource PrimaryBlack}" />
                                <Border Style="{StaticResource InputFieldBorder}" Shadow="{x:Null}">
                                    <Entry Text="{Binding NewLowStockThresholdText}" Keyboard="Numeric" BackgroundColor="Transparent" TextColor="{StaticResource PrimaryBlack}" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Label Text="Unit Cost (₱)" FontFamily="InterSemiBold" FontSize="11" TextColor="{StaticResource PrimaryBlack}" />
                                <Border Style="{StaticResource InputFieldBorder}" Shadow="{x:Null}">
                                    <Entry Text="{Binding NewUnitCostText}" Keyboard="Numeric" BackgroundColor="Transparent" TextColor="{StaticResource PrimaryBlack}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Label Text="{Binding RegistrationError}"
                               Style="{StaticResource InlineErrorLabel}"
                               IsVisible="{Binding HasRegistrationError}" />

                        <!-- Action Buttons -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,6,0,0">
                            <Button Grid.Column="0"
                                    Text="Cancel"
                                    Style="{StaticResource OutlineSecondaryButton}"
                                    Command="{Binding CloseRegistrationModalCommand}" />
                            <Button Grid.Column="1"
                                    Text="Save Raw Ingredient"
                                    Style="{StaticResource PrimaryBlackButton}"
                                    Command="{Binding SubmitNewIngredientCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
