<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Wegs_Cafe.ViewModels"
             xmlns:models="clr-namespace:Wegs_Cafe.Models"
             x:Class="Wegs_Cafe.Views.CartPanelView"
             x:DataType="vm:PosViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="16" RowSpacing="10" BackgroundColor="{StaticResource PureWhite}">

        <Grid ColumnDefinitions="*,Auto">
            <Label Text="Current order" Style="{StaticResource SubHeadingLabel}" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Clear" Style="{StaticResource SecondaryButton}" HeightRequest="34" FontSize="12"
                    Command="{Binding ClearCartCommand}" IsVisible="{Binding Cart.HasItems}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Text="Dine-In" Style="{StaticResource PillButton}" Command="{Binding SetOrderTypeCommand}" CommandParameter="Dine-In">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsDineIn}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryBlack}" />
                        <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1" Text="Take-Out" Style="{StaticResource PillButton}" Command="{Binding SetOrderTypeCommand}" CommandParameter="Take-Out">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsTakeOut}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryBlack}" />
                        <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource InputBorder}" HeightRequest="44">
            <Entry Style="{StaticResource BareEntry}" Placeholder="Table no. or customer name" Text="{Binding TableOrCustomer}" />
        </Border>

        <CollectionView Grid.Row="3" ItemsSource="{Binding Cart.Items}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Tap a product to add it." Style="{StaticResource MutedLabel}" HorizontalOptions="Center" VerticalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CartItem">
                    <Border Style="{StaticResource CreamCard}" Padding="10">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Product.Name}" Style="{StaticResource BodyLabel}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1" Text="{Binding Subtotal, StringFormat='₱{0:N2}'}" Style="{StaticResource PriceLabel}" FontSize="14" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                                <Button Text="−" Style="{StaticResource SecondaryButton}" WidthRequest="40" HeightRequest="36" Padding="0" Clicked="OnDecrement" />
                                <Label Grid.Column="1" Text="{Binding Qty}" Style="{StaticResource PriceLabel}" VerticalOptions="Center" MinimumWidthRequest="24" HorizontalTextAlignment="Center" />
                                <Button Grid.Column="2" Text="+" Style="{StaticResource SecondaryButton}" WidthRequest="40" HeightRequest="36" Padding="0" Clicked="OnIncrement" />
                                <Label Grid.Column="3" Text="{Binding Product.Price, StringFormat='@ ₱{0:N2}'}" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                                <Button Grid.Column="4" Text="✕" BackgroundColor="Transparent" TextColor="{StaticResource MutedText}" WidthRequest="36" HeightRequest="36" Padding="0" Clicked="OnRemove" />
                            </Grid>
                            <Border Style="{StaticResource InputBorder}" HeightRequest="38" BackgroundColor="{StaticResource PureWhite}">
                                <Entry Style="{StaticResource BareEntry}" FontSize="13" Placeholder="Notes (e.g. less ice, 50% sugar)" Text="{Binding Notes}" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="4" Spacing="10">
            <BoxView HeightRequest="1" Color="{StaticResource BorderGray}" />
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding Cart.Count, StringFormat='Total ({0} items)'}" Style="{StaticResource BodyLabel}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding Cart.Subtotal, StringFormat='₱{0:N2}'}" Style="{StaticResource HeadingLabel}" FontSize="22" />
            </Grid>
            <Button Text="Checkout" Style="{StaticResource PrimaryButton}" Command="{Binding CheckoutCommand}" IsEnabled="{Binding Cart.HasItems}" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
