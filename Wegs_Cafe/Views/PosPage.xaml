<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Wegs_Cafe.ViewModels"
             xmlns:models="clr-namespace:Wegs_Cafe.Models"
             x:Class="Wegs_Cafe.Views.PosPage"
             x:DataType="vm:PosViewModel"
             Title="POS"
             BackgroundColor="{StaticResource PureWhite}">
    <Grid>
        <!-- Main area: products (+ cart panel on wide screens) -->
        <Grid x:Name="MainGrid" ColumnDefinitions="65*,35*">
            <Grid RowDefinitions="Auto,Auto,*" Padding="16,16,16,0" RowSpacing="12">
                <Border Style="{StaticResource SearchBorder}">
                    <Entry Style="{StaticResource BareEntry}" Placeholder="Search products" Text="{Binding SearchText}" />
                </Border>

                <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="PillHost" Spacing="8" />
                </ScrollView>

                <CollectionView Grid.Row="2" ItemsSource="{Binding Products}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="No products to show. Add products first." Style="{StaticResource MutedLabel}" HorizontalOptions="Center" Margin="0,40" />
                    </CollectionView.EmptyView>
                    <CollectionView.Footer>
                        <BoxView HeightRequest="90" Color="Transparent" />
                    </CollectionView.Footer>
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout x:Name="ProductGrid" Orientation="Vertical" Span="2" VerticalItemSpacing="10" HorizontalItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Product">
                            <Border Style="{StaticResource ProductTile}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnProductTapped" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsOutOfStock}" Value="True">
                                        <Setter Property="Opacity" Value="0.45" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <VerticalStackLayout Spacing="6">
                                    <Border HeightRequest="86" BackgroundColor="{StaticResource PureWhite}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="0">
                                        <Grid>
                                            <Label Text="☕" FontSize="34" HorizontalOptions="Center" VerticalOptions="Center" />
                                            <Image Source="{Binding ImageUrl, Converter={StaticResource ImagePathConverter}}" Aspect="AspectFill" />
                                        </Grid>
                                    </Border>
                                    <Label Text="{Binding Name}" Style="{StaticResource BodyLabel}" FontAttributes="Bold" MaxLines="2" LineBreakMode="TailTruncation" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Price, StringFormat='₱{0:N2}'}" Style="{StaticResource PriceLabel}" VerticalOptions="Center" />
                                        <Border Grid.Column="1" Style="{StaticResource OutOfStockBadge}" IsVisible="{Binding IsOutOfStock}" Padding="8,3">
                                            <Label Text="Out" Style="{StaticResource BadgeLabel}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource LowStockBadge}" IsVisible="{Binding IsLowStock}" Padding="8,3">
                                            <Label Text="{Binding StockQuantity, StringFormat='{0} left'}" Style="{StaticResource BadgeLabel}" />
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- Tablet: live cart panel -->
            <Border x:Name="TabletCartHost" Grid.Column="1" StrokeThickness="0" Padding="0" BackgroundColor="{StaticResource PureWhite}" />
            <BoxView Grid.Column="1" WidthRequest="1" HorizontalOptions="Start" Color="{StaticResource BorderGray}" />
        </Grid>

        <!-- Phone: floating cart summary bar -->
        <Border x:Name="CartBar" Style="{StaticResource BlackCard}" VerticalOptions="End" Margin="16" Padding="18,14"
                IsVisible="{Binding ShowCartBar}" StrokeShape="RoundRectangle 24">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenCartCommand}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding Cart.Count, StringFormat='{0} items · View order'}" TextColor="{StaticResource PureWhite}" FontFamily="Heading" FontSize="15" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding Cart.Subtotal, StringFormat='₱{0:N2}'}" TextColor="{StaticResource PureWhite}" FontFamily="Heading" FontSize="17" />
            </Grid>
        </Border>

        <!-- Phone: bottom sheet with the full cart + checkout -->
        <Grid x:Name="SheetOverlay" IsVisible="{Binding IsCartOpen}">
            <BoxView Color="Black" Opacity="0.45">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseCartCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border x:Name="SheetHost" VerticalOptions="End" HeightRequest="560" StrokeThickness="0" Padding="0"
                    BackgroundColor="{StaticResource PureWhite}" StrokeShape="RoundRectangle 24,24,0,0" />
        </Grid>
    </Grid>
</ContentPage>
