<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Wegs_Cafe.ViewModels"
             x:Class="Wegs_Cafe.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PureWhite}">
    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                             WidthRequest="400" MaximumWidthRequest="400" Padding="24" Spacing="20">

            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                <Label Text="Weg's Cafe" Style="{StaticResource HeadingLabel}" FontSize="36" HorizontalOptions="Center" />
                <Label Text="POS &amp; Inventory" Style="{StaticResource MutedLabel}" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Sign in" Style="{StaticResource SubHeadingLabel}" />

                    <Border Style="{StaticResource InputBorder}">
                        <Entry Style="{StaticResource BareEntry}" Placeholder="Username"
                               Text="{Binding Username}" Keyboard="Plain" ReturnType="Next" />
                    </Border>

                    <Border Style="{StaticResource InputBorder}">
                        <Entry Style="{StaticResource BareEntry}" Placeholder="Password" IsPassword="True"
                               Text="{Binding Password}" ReturnType="Done"
                               ReturnCommand="{Binding LoginCommand}" />
                    </Border>

                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource AlertDanger}"
                           FontSize="13" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                    <Button Text="Sign in" Style="{StaticResource PrimaryButton}"
                            Command="{Binding LoginCommand}" IsEnabled="{Binding IsNotBusy}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource PrimaryBlack}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
