<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Wegs_Cafe.ViewModels"
             xmlns:models="clr-namespace:Wegs_Cafe.Models"
             x:Class="Wegs_Cafe.Views.ProductRegistrationPage"
             x:DataType="vm:ProductRegistrationViewModel"
             x:Name="ProductCatalogPageRoot"
             Title="{Binding PageTitle}"
             BackgroundColor="{StaticResource PureWhite}">

    <ScrollView>
        <Grid x:Name="ProductPageContainer"
              Padding="16"
              ColumnDefinitions="{OnIdiom Phone='*', Tablet='460,*', Desktop='480,*'}"
              RowDefinitions="{OnIdiom Phone='Auto,Auto', Tablet='Auto', Desktop='Auto'}"
              ColumnSpacing="16"
              RowSpacing="16">

            <!-- Left Column: Product Registration & Recipe Builder Form -->
            <Border Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource CardSurface}"
                    Padding="16"
                    VerticalOptions="Start"
                    Shadow="{x:Null}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding FormSectionTitle}"
                           FontFamily="QuicksandBold"
                           FontSize="17"
                           TextColor="#0A0A0A" />

                    <Border BackgroundColor="#FEF2F2"
                            Stroke="{StaticResource StatusDanger}"
                            Padding="12,8"
                            IsVisible="{Binding HasErrorMessage}"
                            Shadow="{x:Null}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource StatusDanger}" FontFamily="InterSemiBold" FontSize="12" />
                    </Border>

                    <!-- Product Image Preview & Upload Controls -->
                    <Border BackgroundColor="{StaticResource OffWhiteCream}"
                            Stroke="{StaticResource BorderGray}"
                            Padding="12"
                            Shadow="{x:Null}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Grid HeightRequest="120">
                                <Image Source="{Binding ImageUrl, Converter={StaticResource ImagePathConverter}}"
                                       Aspect="AspectFill"
                                       HeightRequest="120"
                                       IsVisible="{Binding HasSelectedImage}" />
                                <VerticalStackLayout VerticalOptions="Center"
                                                     HorizontalOptions="Center"
                                                     Spacing="6"
                                                     IsVisible="{Binding HasSelectedImage, Converter={StaticResource InverseBoolConverter}}">
                                    <Border BackgroundColor="#0A0A0A" WidthRequest="40" HeightRequest="40" StrokeThickness="0" HorizontalOptions="Center" Shadow="{x:Null}">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                                        <Image Source="add_a_photo.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="Product Photo (.jpg, .png, .webp under 5 MB)"
                                           FontSize="11.5"
                                           TextColor="#52525B"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Grid.Column="0"
                                        Text="Gallery Photo"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        HeightRequest="38"
                                        MinimumHeightRequest="38"
                                        Command="{Binding PickImageFromGalleryCommand}" />
                                <Button Grid.Column="1"
                                        Text="Camera Photo"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        HeightRequest="38"
                                        MinimumHeightRequest="38"
                                        ImageSource="add_a_photo.png"
                                        Command="{Binding CaptureImageWithCameraCommand}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Product Name -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Product Name (2 to 80 chars)" FontFamily="InterSemiBold" FontSize="12" TextColor="#0A0A0A" />
                        <Border Style="{StaticResource InputFieldBorder}" Shadow="{x:Null}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding HasProductNameError}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource StatusDanger}" />
                                    <Setter Property="StrokeThickness" Value="1.5" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Entry Text="{Binding ProductName}"
                                   Placeholder="e.g. Iced Spanish Latte"
                                   TextColor="#0A0A0A"
                                   PlaceholderColor="#52525B"
                                   BackgroundColor="Transparent" />
                        </Border>
                        <HorizontalStackLayout Spacing="6" IsVisible="{Binding HasProductNameError}">
                            <Border BackgroundColor="{StaticResource StatusDanger}" WidthRequest="16" HeightRequest="16" StrokeThickness="0" Shadow="{x:Null}">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                <Image Source="error_outline.png" WidthRequest="11" HeightRequest="11" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="{Binding ProductNameError}" Style="{StaticResource InlineErrorLabel}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- SKU & Category -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Stock Keeping Unit (SKU)" FontFamily="InterSemiBold" FontSize="12" TextColor="#0A0A0A" />
                            <Border Style="{StaticResource InputFieldBorder}" Shadow="{x:Null}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding HasStockKeepingUnitError}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource StatusDanger}" />
                                        <Setter Property="StrokeThickness" Value="1.5" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Entry Text="{Binding StockKeepingUnit}"
                                       Placeholder="WEGS-ESP-01"
                                       TextColor="#0A0A0A"
                                       PlaceholderColor="#52525B"
                                       BackgroundColor="Transparent" />
                            </Border>
                            <Label Text="{Binding StockKeepingUnitError}" Style="{StaticResource InlineErrorLabel}" IsVisible="{Binding HasStockKeepingUnitError}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Category" FontFamily="InterSemiBold" FontSize="12" TextColor="#0A0A0A" />
                            <Border Style="{StaticResource InputFieldBorder}" Shadow="{x:Null}">
                                <Picker ItemsSource="{Binding AvailableCategories}"
                                        SelectedItem="{Binding SelectedCategory}"
                                        TextColor="#0A0A0A"
                                        TitleColor="#0A0A0A" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Selling Price -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Selling Price (₱)" FontFamily="InterSemiBold" FontSize="12" TextColor="#0A0A0A" />
                        <Border Style="{StaticResource InputFieldBorder}" Shadow="{x:Null}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding HasSellingPriceError}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource StatusDanger}" />
                                    <Setter Property="StrokeThickness" Value="1.5" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Entry Text="{Binding SellingPriceText}"
                                   Keyboard="Numeric"
                                   Placeholder="150.00"
                                   TextColor="#0A0A0A"
                                   PlaceholderColor="#52525B"
                                   BackgroundColor="Transparent" />
                        </Border>
                        <Label Text="{Binding SellingPriceError}" Style="{StaticResource InlineErrorLabel}" IsVisible="{Binding HasSellingPriceError}" />
                    </VerticalStackLayout>

                    <!-- Live Recipe Food Cost & Gross Profit Margin Badge -->
                    <Border BackgroundColor="#F4F4F5"
                            Stroke="#E4E4E7"
                            StrokeThickness="1"
                            Padding="12,10"
                            Shadow="{x:Null}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                            <BoxView Grid.Column="0"
                                     WidthRequest="4"
                                     Color="{Binding ProfitBadgeColor}"
                                     CornerRadius="2"
                                     VerticalOptions="Fill" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="RECIPE COST &amp; PROFIT MARGIN"
                                       FontFamily="InterSemiBold"
                                       FontSize="10"
                                       TextColor="#71717A" />
                                <Label Text="{Binding ProfitBadgeText}"
                                       FontFamily="QuicksandBold"
                                       FontSize="13"
                                       TextColor="{Binding ProfitBadgeColor}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- INTERACTIVE RECIPE INGREDIENT BUILDER CARD -->
                    <Border BackgroundColor="{StaticResource OffWhiteCream}"
                            Stroke="{StaticResource BorderGray}"
                            StrokeThickness="1"
                            Padding="14"
                            Shadow="{x:Null}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="PRODUCT RECIPE (INGREDIENTS PER SERVING)"
                                   FontFamily="QuicksandBold"
                                   FontSize="13"
                                   TextColor="#0A0A0A" />
                            <Label Text="Raw materials consumed each time this menu item is prepared at POS."
                                   FontSize="11"
                                   TextColor="#71717A" />

                            <!-- Add Ingredient Row -->
                            <Grid ColumnDefinitions="2*,*,Auto,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                <!-- Raw Ingredient Picker -->
                                <Border Grid.Column="0" Style="{StaticResource InputFieldBorder}" HeightRequest="38" Padding="6,0" Shadow="{x:Null}">
                                    <Picker ItemsSource="{Binding AvailableRawIngredients}"
                                            ItemDisplayBinding="{Binding IngredientName}"
                                            SelectedItem="{Binding SelectedRecipeIngredient}"
                                            Title="Select Ingredient"
                                            TextColor="#0A0A0A"
                                            FontSize="12" />
                                </Border>

                                <!-- Quantity Required Input -->
                                <Border Grid.Column="1" Style="{StaticResource InputFieldBorder}" HeightRequest="38" Padding="6,0" Shadow="{x:Null}">
                                    <Entry Text="{Binding RecipeQuantityRequiredText}"
                                           Keyboard="Numeric"
                                           Placeholder="Qty"
                                           TextColor="#0A0A0A"
                                           FontSize="12"
                                           BackgroundColor="Transparent" />
                                </Border>

                                <!-- Unit Label -->
                                <Label Grid.Column="2"
                                       Text="{Binding SelectedIngredientUnitLabel}"
                                       FontFamily="InterSemiBold"
                                       FontSize="12"
                                       TextColor="#0A0A0A"
                                       VerticalOptions="Center" />

                                <!-- Add Button -->
                                <Button Grid.Column="3"
                                        Text="+ Add"
                                        Style="{StaticResource PrimaryBlackButton}"
                                        HeightRequest="36"
                                        Padding="12,0"
                                        FontSize="12"
                                        CornerRadius="8"
                                        Command="{Binding AddRecipeIngredientCommand}" />
                            </Grid>

                            <Label Text="{Binding RecipeBuilderError}"
                                   Style="{StaticResource InlineErrorLabel}"
                                   IsVisible="{Binding HasRecipeBuilderError}" />

                            <!-- Currently Attached Ingredients Chips / Rows -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentRecipeIngredients}"
                                                 Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:RecipeIngredientItem">
                                        <Border BackgroundColor="{StaticResource PureWhite}"
                                                Stroke="{StaticResource BorderGray}"
                                                Padding="10,6"
                                                Shadow="{x:Null}">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                                <Label Grid.Column="0"
                                                       Text="{Binding IngredientName}"
                                                       FontFamily="InterSemiBold"
                                                       FontSize="12"
                                                       TextColor="#0A0A0A"
                                                       VerticalOptions="Center"
                                                       LineBreakMode="TailTruncation" />

                                                <Border Grid.Column="1"
                                                        BackgroundColor="#E4E4E7"
                                                        Padding="8,2"
                                                        StrokeThickness="0"
                                                        VerticalOptions="Center"
                                                        Shadow="{x:Null}">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                                    <Label Text="{Binding QuantityDisplay}"
                                                           FontFamily="QuicksandBold"
                                                           FontSize="11"
                                                           TextColor="#0A0A0A" />
                                                </Border>

                                                <Button Grid.Column="2"
                                                        Text="Remove"
                                                        HeightRequest="28"
                                                        Padding="8,0"
                                                        FontSize="10"
                                                        FontFamily="InterSemiBold"
                                                        BackgroundColor="#FEE2E2"
                                                        TextColor="{StaticResource StatusDanger}"
                                                        CornerRadius="6"
                                                        Command="{Binding Source={x:Reference ProductCatalogPageRoot}, Path=BindingContext.RemoveRecipeIngredientCommand}"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Initial Stock, Low Threshold & Unit -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Initial Stock" FontFamily="InterSemiBold" FontSize="12" TextColor="#0A0A0A" />
                            <Border Style="{StaticResource InputFieldBorder}" Shadow="{x:Null}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding HasStockQuantityError}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource StatusDanger}" />
                                        <Setter Property="StrokeThickness" Value="1.5" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Entry Text="{Binding StockQuantityText}"
                                       Keyboard="Numeric"
                                       Placeholder="25"
                                       TextColor="#0A0A0A"
                                       PlaceholderColor="#52525B"
                                       BackgroundColor="Transparent" />
                            </Border>
                            <Label Text="{Binding StockQuantityError}" Style="{StaticResource InlineErrorLabel}" IsVisible="{Binding HasStockQuantityError}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Low Threshold" FontFamily="InterSemiBold" FontSize="12" TextColor="#0A0A0A" />
                            <Border Style="{StaticResource InputFieldBorder}" Shadow="{x:Null}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding HasLowStockThresholdError}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource StatusDanger}" />
                                        <Setter Property="StrokeThickness" Value="1.5" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Entry Text="{Binding LowStockThresholdText}"
                                       Keyboard="Numeric"
                                       Placeholder="10"
                                       TextColor="#0A0A0A"
                                       PlaceholderColor="#52525B"
                                       BackgroundColor="Transparent" />
                            </Border>
                            <Label Text="{Binding LowStockThresholdError}" Style="{StaticResource InlineErrorLabel}" IsVisible="{Binding HasLowStockThresholdError}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="4">
                            <Label Text="Unit" FontFamily="InterSemiBold" FontSize="12" TextColor="#0A0A0A" />
                            <Border Style="{StaticResource InputFieldBorder}" Shadow="{x:Null}">
                                <Entry Text="{Binding MeasurementUnit}"
                                       Placeholder="cups"
                                       TextColor="#0A0A0A"
                                       PlaceholderColor="#52525B"
                                       BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Barista Drink Modifiers & Availability -->
                    <Border BackgroundColor="{StaticResource OffWhiteCream}" Stroke="{StaticResource BorderGray}" Padding="12,10" Shadow="{x:Null}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="Allow Barista Modifiers (Ice, Sugar, Add-ons)" FontFamily="InterSemiBold" FontSize="13" TextColor="#0A0A0A" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding AllowDrinkModifiers}" OnColor="#0A0A0A" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="Available for POS Ordering" FontFamily="InterSemiBold" FontSize="13" TextColor="#0A0A0A" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding IsAvailable}" OnColor="#0A0A0A" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="{Binding SaveButtonLabel}"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                IsEnabled="{Binding CanSubmitForm}"
                                Command="{Binding SaveProductCommand}" />
                        <Button Grid.Column="1"
                                Text="Reset"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                Command="{Binding ResetProductFormCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Right Column: Searchable Menu Catalog with Recipe Badges -->
            <Border Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                    Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                    Style="{StaticResource CardSurface}"
                    Padding="16"
                    Shadow="{x:Null}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="REGISTERED MENU CATALOG"
                           FontFamily="QuicksandBold"
                           FontSize="17"
                           TextColor="#0A0A0A" />

                    <!-- Search Bar -->
                    <Border Style="{StaticResource SearchPillBorder}" Shadow="{x:Null}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Border Grid.Column="0" BackgroundColor="#0A0A0A" WidthRequest="28" HeightRequest="28" StrokeThickness="0" VerticalOptions="Center" Shadow="{x:Null}">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Image Source="search.png" WidthRequest="15" HeightRequest="15" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Entry Grid.Column="1"
                                   Text="{Binding SearchQuery}"
                                   Placeholder="Search product name, SKU, or category..."
                                   BackgroundColor="Transparent"
                                   TextColor="#0A0A0A"
                                   PlaceholderColor="#52525B" />
                        </Grid>
                    </Border>

                    <!-- Category Filter Pills -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding FilterCategories}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Text="{Binding .}"
                                            Style="{StaticResource FilterChipStyle}"
                                            Command="{Binding Source={x:Reference ProductCatalogPageRoot}, Path=BindingContext.SelectFilterCategoryCommand}"
                                            CommandParameter="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Product List -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding FilteredProducts}"
                                         Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Product">
                                <Border BackgroundColor="{StaticResource OffWhiteCream}"
                                        Stroke="{StaticResource BorderGray}"
                                        StrokeThickness="1"
                                        Padding="14,12"
                                        Shadow="{x:Null}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                    <VerticalStackLayout Spacing="8">
                                        <!-- Row 0: Name & Category -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <Label Grid.Column="0"
                                                   Text="{Binding ProductName}"
                                                   FontFamily="QuicksandBold"
                                                   FontSize="15"
                                                   TextColor="#0A0A0A"
                                                   MaxLines="1"
                                                   LineBreakMode="TailTruncation" />

                                            <Border Grid.Column="1"
                                                    BackgroundColor="#E4E4E7"
                                                    StrokeThickness="0"
                                                    Padding="8,2"
                                                    Shadow="{x:Null}">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                                <Label Text="{Binding Category}"
                                                       FontFamily="InterSemiBold"
                                                       FontSize="10"
                                                       TextColor="#0A0A0A" />
                                            </Border>
                                        </Grid>

                                        <!-- Row 1: SKU + Pricing + Calculated Cost -->
                                        <Label FontSize="12" TextColor="#0A0A0A">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding StockKeepingUnit}" TextColor="#71717A" />
                                                    <Span Text=" · " TextColor="#A1A1AA" />
                                                    <Span Text="{Binding SellingPrice, StringFormat='₱{0:N2}'}" FontAttributes="Bold" />
                                                    <Span Text=" (Cost: " TextColor="#71717A" />
                                                    <Span Text="{Binding EffectiveCostPrice, StringFormat='₱{0:N2}'}" TextColor="#16A34A" FontAttributes="Bold" />
                                                    <Span Text=" | " TextColor="#71717A" />
                                                    <Span Text="{Binding StockDisplayText}" FontAttributes="Bold" />
                                                    <Span Text=")" TextColor="#71717A" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <!-- Row 2: Recipe Ingredients Pill Summary -->
                                        <Border BackgroundColor="{StaticResource PureWhite}"
                                                Padding="8,4"
                                                StrokeThickness="0"
                                                Shadow="{x:Null}">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                            <Label Text="{Binding RecipeIngredients, Converter={StaticResource RecipeSummaryConverter}}"
                                                   FontSize="11"
                                                   TextColor="#52525B"
                                                   LineBreakMode="TailTruncation" />
                                        </Border>

                                        <!-- Row 3: Action Buttons -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2,0,0">
                                            <Label Grid.Column="0"
                                                   Text="{Binding GrossProfitMarginPercent, StringFormat='Margin: {0:0.#}%'}"
                                                   FontFamily="QuicksandBold"
                                                   FontSize="12"
                                                   TextColor="#16A34A"
                                                   VerticalOptions="Center" />

                                            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                                <Button Text="Edit"
                                                        Style="{StaticResource CompactCardButtonStyle}"
                                                        BackgroundColor="#0A0A0A"
                                                        TextColor="#FFFFFF"
                                                        Command="{Binding Source={x:Reference ProductCatalogPageRoot}, Path=BindingContext.EditProductCommand}"
                                                        CommandParameter="{Binding .}" />

                                                <Button Text="Delete"
                                                        Style="{StaticResource CompactCardButtonStyle}"
                                                        BackgroundColor="#DC2626"
                                                        TextColor="#FFFFFF"
                                                        Command="{Binding Source={x:Reference ProductCatalogPageRoot}, Path=BindingContext.DeleteProductCommand}"
                                                        CommandParameter="{Binding .}" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </Grid>
    </ScrollView>
</ContentPage>
