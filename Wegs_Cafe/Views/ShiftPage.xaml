<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Wegs_Cafe.ViewModels"
             x:Class="Wegs_Cafe.Views.ShiftPage"
             x:DataType="vm:ShiftViewModel"
             Title="Shift (X/Z)"
             BackgroundColor="{StaticResource PureWhite}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16" MaximumWidthRequest="560" HorizontalOptions="Center">
            <Label Text="Shift &amp; X/Z Reading" Style="{StaticResource HeadingLabel}" />

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource AlertDanger}" FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <!-- Open a shift -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding NoOpenShift}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Start a new shift" Style="{StaticResource SubHeadingLabel}" />
                    <Label Text="Enter the starting cash in the drawer to open a shift." Style="{StaticResource MutedLabel}" />
                    <Border Style="{StaticResource InputBorder}">
                        <Entry Style="{StaticResource BareEntry}" Keyboard="Numeric" Placeholder="Opening cash (₱)" Text="{Binding OpeningCashText}" />
                    </Border>
                    <Button Text="Open shift" Style="{StaticResource PrimaryButton}" Command="{Binding OpenCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Active shift (X reading + close for Z reading) -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding HasOpenShift}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="X Reading — Live Shift Totals" Style="{StaticResource SubHeadingLabel}" />
                    <Label Text="{Binding ShiftInfo}" Style="{StaticResource MutedLabel}" />

                    <Border Style="{StaticResource CreamCard}">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Completed orders" Style="{StaticResource BodyLabel}" />
                                <Label Grid.Column="1" Text="{Binding Reading.OrderCount}" Style="{StaticResource PriceLabel}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Voided orders" Style="{StaticResource BodyLabel}" />
                                <Label Grid.Column="1" Text="{Binding Reading.VoidedCount}" Style="{StaticResource BodyLabel}" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource BorderGray}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Total sales" Style="{StaticResource BodyLabel}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding Reading.TotalSales, StringFormat='₱{0:N2}'}" Style="{StaticResource PriceLabel}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="  Cash sales" Style="{StaticResource MutedLabel}" />
                                <Label Grid.Column="1" Text="{Binding Reading.CashSales, StringFormat='₱{0:N2}'}" Style="{StaticResource MutedLabel}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="  GCash sales" Style="{StaticResource MutedLabel}" />
                                <Label Grid.Column="1" Text="{Binding Reading.GCashSales, StringFormat='₱{0:N2}'}" Style="{StaticResource MutedLabel}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="  Card sales" Style="{StaticResource MutedLabel}" />
                                <Label Grid.Column="1" Text="{Binding Reading.CardSales, StringFormat='₱{0:N2}'}" Style="{StaticResource MutedLabel}" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource BorderGray}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Opening cash" Style="{StaticResource BodyLabel}" />
                                <Label Grid.Column="1" Text="{Binding Reading.OpeningCash, StringFormat='₱{0:N2}'}" Style="{StaticResource BodyLabel}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Expected cash in drawer" Style="{StaticResource BodyLabel}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding Reading.ExpectedCash, StringFormat='₱{0:N2}'}" Style="{StaticResource PriceLabel}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Close shift (Z Reading)" Style="{StaticResource SubHeadingLabel}" Margin="0,6,0,0" />
                    <Label Text="Count the physical cash in the drawer. Any difference will be recorded in the audit log." Style="{StaticResource MutedLabel}" />
                    <Border Style="{StaticResource InputBorder}">
                        <Entry Style="{StaticResource BareEntry}" Keyboard="Numeric" Placeholder="Actual counted cash (₱)" Text="{Binding ActualCashText}" />
                    </Border>
                    <Button Text="Close shift (Z Reading)" Style="{StaticResource PrimaryButton}" Command="{Binding CloseCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Completed Z Report -->
            <Border Style="{StaticResource ReceiptPreview}" IsVisible="{Binding HasZReport}">
                <Label Text="{Binding ZReport}" Style="{StaticResource ReceiptLabel}" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
