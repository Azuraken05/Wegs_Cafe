<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Wegs_Cafe.ViewModels"
             xmlns:models="clr-namespace:Wegs_Cafe.Models"
             x:Class="Wegs_Cafe.Views.OrderHistoryPage"
             x:DataType="vm:OrderHistoryViewModel"
             Title="Orders"
             BackgroundColor="{StaticResource PureWhite}">
    <Grid RowDefinitions="Auto,*" Padding="20" RowSpacing="14">
        <VerticalStackLayout Spacing="12">
            <Label Text="Order history" Style="{StaticResource HeadingLabel}" />
            <Border Style="{StaticResource SearchBorder}">
                <Entry Style="{StaticResource BareEntry}" Placeholder="Search receipt #, cashier or table" Text="{Binding SearchText}" />
            </Border>
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource AlertDanger}" FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No orders yet." Style="{StaticResource MutedLabel}" HorizontalOptions="Center" Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="{OnIdiom Phone=1, Tablet=2}" VerticalItemSpacing="10" HorizontalItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Order">
                    <Border Style="{StaticResource Card}" Padding="14">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding ReceiptNumber}" Style="{StaticResource PriceLabel}" />
                                <Label Grid.Column="1" Text="{Binding TotalAmount, StringFormat='₱{0:N2}'}" Style="{StaticResource PriceLabel}" />
                            </Grid>
                            <Label Text="{Binding CreatedDisplay}" Style="{StaticResource MutedLabel}" />
                            <Label Text="{Binding ItemsSummary}" Style="{StaticResource BodyLabel}" FontSize="13" MaxLines="2" LineBreakMode="TailTruncation" />
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding PaymentMethod}" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                                <Label Text="{Binding CashierName, StringFormat='· {0}'}" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                                <Border Style="{StaticResource PaidBadge}" IsVisible="{Binding IsNotVoided}"><Label Text="Paid" Style="{StaticResource BadgeLabel}" /></Border>
                                <Border Style="{StaticResource OutOfStockBadge}" IsVisible="{Binding IsVoided}"><Label Text="VOIDED" Style="{StaticResource BadgeLabel}" /></Border>
                            </HorizontalStackLayout>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,6,0,0">
                                <Button Text="View receipt" Style="{StaticResource SecondaryButton}" HeightRequest="38" FontSize="12" Clicked="OnViewClicked" />
                                <Button Grid.Column="1" Text="Void" Style="{StaticResource DangerButton}" HeightRequest="38" FontSize="12"
                                        IsVisible="{Binding IsNotVoided}" Clicked="OnVoidClicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
