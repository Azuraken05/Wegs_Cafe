<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Wegs_Cafe.ViewModels"
             xmlns:models="clr-namespace:Wegs_Cafe.Models"
             x:Class="Wegs_Cafe.Views.UserManagementPage"
             x:DataType="vm:UserManagementViewModel"
             x:Name="UserManagementRoot"
             Title="{Binding PageTitle}"
             BackgroundColor="{StaticResource PureWhite}">

    <ScrollView>
        <Grid x:Name="UserManagementContainer"
              Padding="20"
              ColumnDefinitions="{OnIdiom Phone='*', Tablet='440,*', Desktop='460,*'}"
              RowDefinitions="{OnIdiom Phone='Auto,Auto', Tablet='Auto', Desktop='Auto'}"
              ColumnSpacing="18"
              RowSpacing="18">

            <!-- Left Column: Owner Staff Registration Form with Real-Time Inline Validation -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardSurface}" Padding="20" VerticalOptions="Start">
                <VerticalStackLayout Spacing="14">
                    <Label Text="REGISTER STAFF ACCOUNT &amp; ROLE PERMISSIONS"
                           FontFamily="QuicksandBold"
                           FontSize="17"
                           TextColor="{StaticResource PrimaryBlack}" />

                    <Label Text="Owner-only provisioning via isolated secondary Firebase Auth so the Owner stays logged in."
                           Style="{StaticResource MutedCaption}" />

                    <Border BackgroundColor="#FEF2F2"
                            Stroke="{StaticResource StatusDanger}"
                            Padding="12,8"
                            IsVisible="{Binding HasErrorMessage}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <HorizontalStackLayout Spacing="8">
                            <Border BackgroundColor="{StaticResource StatusDanger}" WidthRequest="22" HeightRequest="22" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                                <Image Source="error_outline.png" WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource StatusDanger}" FontFamily="InterSemiBold" FontSize="12" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Full Name -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Full Name" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource PrimaryBlack}" />
                        <Border Style="{StaticResource InputFieldBorder}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding HasFullNameError}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource StatusDanger}" />
                                    <Setter Property="StrokeThickness" Value="1.5" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Entry Text="{Binding FullName}" Placeholder="e.g. Maria Santos" BackgroundColor="Transparent" />
                        </Border>
                        <HorizontalStackLayout Spacing="6" IsVisible="{Binding HasFullNameError}">
                            <Border BackgroundColor="{StaticResource StatusDanger}" WidthRequest="16" HeightRequest="16" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                <Image Source="error_outline.png" WidthRequest="11" HeightRequest="11" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="{Binding FullNameError}" Style="{StaticResource InlineErrorLabel}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Email Address -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Email Address" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource PrimaryBlack}" />
                        <Border Style="{StaticResource InputFieldBorder}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding HasEmailAddressError}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource StatusDanger}" />
                                    <Setter Property="StrokeThickness" Value="1.5" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Entry Text="{Binding EmailAddress}" Keyboard="Email" Placeholder="barista@wegscafe.com" BackgroundColor="Transparent" />
                        </Border>
                        <HorizontalStackLayout Spacing="6" IsVisible="{Binding HasEmailAddressError}">
                            <Border BackgroundColor="{StaticResource StatusDanger}" WidthRequest="16" HeightRequest="16" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                <Image Source="error_outline.png" WidthRequest="11" HeightRequest="11" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="{Binding EmailAddressError}" Style="{StaticResource InlineErrorLabel}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Password + Quick-Switch PIN -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Password" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource PrimaryBlack}" />
                            <Border Style="{StaticResource InputFieldBorder}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding HasPasswordError}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource StatusDanger}" />
                                        <Setter Property="StrokeThickness" Value="1.5" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Entry Text="{Binding Password}" IsPassword="True" Placeholder="8+ chars, 1 upper, 1 num" BackgroundColor="Transparent" />
                            </Border>
                            <Label Text="{Binding PasswordError}" Style="{StaticResource InlineErrorLabel}" IsVisible="{Binding HasPasswordError}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Quick-Switch PIN" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource PrimaryBlack}" />
                            <Border Style="{StaticResource InputFieldBorder}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding HasSecurityPinError}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource StatusDanger}" />
                                        <Setter Property="StrokeThickness" Value="1.5" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Entry Text="{Binding SecurityPin}" IsPassword="True" Keyboard="Numeric" MaxLength="6" Placeholder="4-6 digits" BackgroundColor="Transparent" />
                            </Border>
                            <Label Text="{Binding SecurityPinError}" Style="{StaticResource InlineErrorLabel}" IsVisible="{Binding HasSecurityPinError}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Assigned User Level / Role -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Assigned User Level / Role" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource PrimaryBlack}" />
                        <Border Style="{StaticResource InputFieldBorder}">
                            <Picker ItemsSource="{Binding RolePresetOptions}"
                                    SelectedItem="{Binding SelectedRolePreset}"
                                    TextColor="{StaticResource PrimaryBlack}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Custom Role Name (shown when Custom Role is selected) -->
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding IsCustomRolePreset}">
                        <Label Text="Custom Role Title" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource PrimaryBlack}" />
                        <Border Style="{StaticResource InputFieldBorder}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding HasRoleNameError}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource StatusDanger}" />
                                    <Setter Property="StrokeThickness" Value="1.5" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Entry Text="{Binding CustomRoleName}" Placeholder="e.g. Shift Supervisor" BackgroundColor="Transparent" />
                        </Border>
                        <Label Text="{Binding RoleNameError}" Style="{StaticResource InlineErrorLabel}" IsVisible="{Binding HasRoleNameError}" />
                    </VerticalStackLayout>

                    <!-- Granular Role Permission Toggles -->
                    <Border BackgroundColor="{StaticResource OffWhiteCream}"
                            Stroke="{StaticResource BorderGray}"
                            Padding="14,12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="GRANULAR ROLE PERMISSIONS" FontFamily="QuicksandBold" FontSize="12" TextColor="{StaticResource PrimaryBlack}" />

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Access Point of Sale (can_access_point_of_sale)" FontSize="12" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding CanAccessPointOfSale}" OnColor="{StaticResource PrimaryBlack}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="View Inventory Levels (can_view_inventory)" FontSize="12" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding CanViewInventory}" OnColor="{StaticResource PrimaryBlack}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Restock / Adjust Inventory (can_restock_inventory)" FontSize="12" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding CanRestockInventory}" OnColor="{StaticResource PrimaryBlack}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Register Products (can_register_products)" FontSize="12" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding CanRegisterProducts}" OnColor="{StaticResource PrimaryBlack}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Void Orders (can_void_orders)" FontSize="12" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding CanVoidOrders}" OnColor="{StaticResource PrimaryBlack}" />
                            </Grid>

                            <Label Text="{Binding PermissionsError}" Style="{StaticResource InlineErrorLabel}" IsVisible="{Binding HasPermissionsError}" />
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="Register Staff Account"
                            Style="{StaticResource PrimaryBlackButton}"
                            IsEnabled="{Binding CanSubmitForm}"
                            Command="{Binding RegisterStaffAccountCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Right Column: Registered Accounts Directory -->
            <Border Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                    Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                    Style="{StaticResource CardSurface}"
                    Padding="20">
                <VerticalStackLayout Spacing="14">
                    <Label Text="REGISTERED USER ACCOUNTS (users)"
                           FontFamily="QuicksandBold"
                           FontSize="17"
                           TextColor="{StaticResource PrimaryBlack}" />

                    <CollectionView ItemsSource="{Binding UserAccounts}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:UserAccount">
                                <Border BackgroundColor="{StaticResource OffWhiteCream}"
                                        Stroke="{StaticResource BorderGray}"
                                        Padding="14,12">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding FullName}"
                                                       FontFamily="QuicksandBold"
                                                       FontSize="15"
                                                       TextColor="{StaticResource PrimaryBlack}" />
                                                <Border BackgroundColor="{StaticResource PrimaryBlack}"
                                                        Padding="8,2"
                                                        StrokeThickness="0">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                    <Label Text="{Binding RoleBadgeText}"
                                                           FontFamily="QuicksandBold"
                                                           FontSize="10"
                                                           TextColor="{StaticResource PureWhite}" />
                                                </Border>
                                            </HorizontalStackLayout>

                                            <Label Text="{Binding EmailAddress}"
                                                   Style="{StaticResource MutedCaption}" />
                                        </VerticalStackLayout>

                                        <Border Grid.Column="1"
                                                BackgroundColor="{StaticResource StatusSuccess}"
                                                Padding="10,4"
                                                StrokeThickness="0"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource StatusDanger}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding StatusBadgeText}"
                                                   FontFamily="QuicksandBold"
                                                   FontSize="11"
                                                   TextColor="{StaticResource PureWhite}" />
                                        </Border>

                                        <Button Grid.Column="2"
                                                Text="Toggle Active"
                                                Style="{StaticResource OutlineSecondaryButton}"
                                                HeightRequest="36"
                                                Padding="12,0"
                                                FontSize="12"
                                                Command="{Binding Source={x:Reference UserManagementRoot}, Path=BindingContext.ToggleAccountActiveStatusCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </Grid>
    </ScrollView>
</ContentPage>
