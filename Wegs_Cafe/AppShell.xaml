<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Wegs_Cafe.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Wegs_Cafe.Views"
    Title="Weg's Cafe"
    FlyoutBehavior="Flyout"
    FlyoutWidth="290"
    FlyoutBackgroundColor="{StaticResource PrimaryBlack}"
    Shell.BackgroundColor="{StaticResource PrimaryBlack}"
    Shell.ForegroundColor="{StaticResource PureWhite}"
    Shell.TitleColor="{StaticResource PureWhite}">

    <!-- Monochrome Sidebar Flyout Item Template with Google Material Symbols SVG Icons -->
    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid Padding="14,4">
                <Border x:Name="FlyoutItemBorder"
                        StrokeThickness="0"
                        Padding="14,12"
                        BackgroundColor="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="{StaticResource CharcoalSurface}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>
                    <Grid ColumnDefinitions="24,*" ColumnSpacing="14" VerticalOptions="Center">
                        <Image Grid.Column="0"
                               Source="{Binding FlyoutIcon}"
                               WidthRequest="20"
                               HeightRequest="20"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding Title}"
                               TextColor="{StaticResource PureWhite}"
                               FontFamily="QuicksandBold"
                               FontSize="14"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <Shell.MenuItemTemplate>
        <DataTemplate>
            <Grid Padding="14,10">
                <Border Stroke="{StaticResource StatusDanger}"
                        StrokeThickness="1"
                        Padding="14,12"
                        BackgroundColor="{StaticResource CharcoalSurface}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="24,*" ColumnSpacing="14" VerticalOptions="Center">
                        <Image Grid.Column="0"
                               Source="{Binding IconImageSource}"
                               WidthRequest="20"
                               HeightRequest="20"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding Text}"
                               TextColor="{StaticResource StatusDanger}"
                               FontFamily="QuicksandBold"
                               FontSize="14"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </Shell.MenuItemTemplate>

    <!-- 1. Sales & Analytics Dashboard (Default First Landing Page) -->
    <FlyoutItem x:Name="SalesAnalyticsDashboardFlyoutItem"
                Title="Sales &amp; Analytics Dashboard"
                Icon="dashboard.png"
                Route="SalesAnalyticsDashboardPage">
        <ShellContent ContentTemplate="{DataTemplate views:SalesAnalyticsDashboardPage}"
                      Route="SalesAnalyticsDashboardPage" />
    </FlyoutItem>

    <!-- 2. Point of Sale Terminal -->
    <FlyoutItem x:Name="PointOfSaleFlyoutItem"
                Title="Point of Sale Terminal"
                Icon="point_of_sale.png"
                Route="PointOfSalePage">
        <ShellContent ContentTemplate="{DataTemplate views:PointOfSalePage}"
                      Route="PointOfSalePage" />
    </FlyoutItem>

    <!-- 3. Product Registration & Menu Catalog -->
    <FlyoutItem x:Name="ProductRegistrationFlyoutItem"
                Title="Product Registration"
                Icon="add_box.png"
                Route="ProductRegistrationPage">
        <ShellContent ContentTemplate="{DataTemplate views:ProductRegistrationPage}"
                      Route="ProductRegistrationPage" />
    </FlyoutItem>

    <!-- 4. Inventory Management & Stock Ledger -->
    <FlyoutItem x:Name="InventoryManagementFlyoutItem"
                Title="Inventory Management"
                Icon="inventory_2.png"
                Route="InventoryManagementPage">
        <ShellContent ContentTemplate="{DataTemplate views:InventoryManagementPage}"
                      Route="InventoryManagementPage" />
    </FlyoutItem>

    <!-- 5. User & Staff Account Management (Owner Only) -->
    <FlyoutItem x:Name="UserManagementFlyoutItem"
                Title="Staff &amp; User Accounts"
                Icon="group.png"
                Route="UserManagementPage">
        <ShellContent ContentTemplate="{DataTemplate views:UserManagementPage}"
                      Route="UserManagementPage" />
    </FlyoutItem>

    <!-- 6. Immutable System Audit Trail -->
    <FlyoutItem x:Name="AuditTrailFlyoutItem"
                Title="System Audit Trail"
                Icon="history_edu.png"
                Route="AuditTrailPage">
        <ShellContent ContentTemplate="{DataTemplate views:AuditTrailPage}"
                      Route="AuditTrailPage" />
    </FlyoutItem>

    <!-- Sign Out Menu Item -->
    <MenuItem Text="Sign Out of Terminal"
              IconImageSource="logout.png"
              Clicked="OnSignOutClicked" />

</Shell>
