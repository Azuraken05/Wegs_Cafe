<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Wegs_Cafe.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Wegs_Cafe.Views"
    Title="Weg's Cafe"
    FlyoutBehavior="Flyout"
    FlyoutWidth="290"
    FlyoutBackgroundColor="{StaticResource OffWhiteCream}"
    Shell.BackgroundColor="{StaticResource PrimaryBlack}"
    Shell.ForegroundColor="{StaticResource PureWhite}"
    Shell.TitleColor="{StaticResource PureWhite}">

    <!-- Monochrome Sidebar Flyout Item Template (OffWhiteCream canvas + PrimaryBlack active item) -->
    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid Padding="14,4">
                <Border x:Name="FlyoutItemBorder"
                        StrokeThickness="1"
                        Stroke="Transparent"
                        Padding="12,10"
                        BackgroundColor="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                        <Setter Property="Stroke" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryBlack}" />
                                        <Setter Property="Stroke" Value="{StaticResource PrimaryBlack}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>
                    <Grid ColumnDefinitions="34,*" ColumnSpacing="12" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource PrimaryBlack}"
                                WidthRequest="32"
                                HeightRequest="32"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Image Source="{Binding FlyoutIcon}"
                                   WidthRequest="18"
                                   HeightRequest="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1"
                               Text="{Binding Title}"
                               TextColor="{StaticResource PrimaryBlack}"
                               FontFamily="QuicksandBold"
                               FontSize="14"
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding Source={x:Reference FlyoutItemBorder}, Path=BackgroundColor}"
                                             Value="{StaticResource PrimaryBlack}">
                                    <Setter Property="TextColor" Value="{StaticResource PureWhite}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <Shell.MenuItemTemplate>
        <DataTemplate>
            <Grid Padding="14,12">
                <Border Stroke="{StaticResource StatusDanger}"
                        StrokeThickness="1"
                        Padding="12,10"
                        BackgroundColor="{StaticResource PureWhite}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="34,*" ColumnSpacing="12" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource StatusDanger}"
                                WidthRequest="32"
                                HeightRequest="32"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Image Source="{Binding IconImageSource}"
                                   WidthRequest="18"
                                   HeightRequest="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1"
                               Text="{Binding Text}"
                               TextColor="{StaticResource StatusDanger}"
                               FontFamily="QuicksandBold"
                               FontSize="14"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </Shell.MenuItemTemplate>

    <!-- 1. Point of Sale (Default Landing Screen for both Owner & Barista) -->
    <FlyoutItem x:Name="PointOfSaleFlyoutItem"
                Title="Point of Sale"
                Icon="point_of_sale.png"
                Route="PointOfSalePage">
        <ShellContent ContentTemplate="{DataTemplate views:PointOfSalePage}"
                      Route="PointOfSalePage" />
    </FlyoutItem>

    <!-- 2. Product Registration (Owner & permitted roles) -->
    <FlyoutItem x:Name="ProductRegistrationFlyoutItem"
                Title="Product Registration"
                Icon="add_box.png"
                Route="ProductRegistrationPage">
        <ShellContent ContentTemplate="{DataTemplate views:ProductRegistrationPage}"
                      Route="ProductRegistrationPage" />
    </FlyoutItem>

    <!-- 3. Inventory Management (Owner & Barista stock tracking) -->
    <FlyoutItem x:Name="InventoryManagementFlyoutItem"
                Title="Inventory Management"
                Icon="inventory_2.png"
                Route="InventoryManagementPage">
        <ShellContent ContentTemplate="{DataTemplate views:InventoryManagementPage}"
                      Route="InventoryManagementPage" />
    </FlyoutItem>

    <!-- 4. User & Role Management (Owner Only) -->
    <FlyoutItem x:Name="UserManagementFlyoutItem"
                Title="User &amp; Role Management"
                Icon="manage_accounts.png"
                Route="UserManagementPage">
        <ShellContent ContentTemplate="{DataTemplate views:UserManagementPage}"
                      Route="UserManagementPage" />
    </FlyoutItem>

    <!-- Sign Out Menu Item -->
    <MenuItem Text="Sign Out"
              IconImageSource="logout.png"
              Clicked="OnSignOutClicked" />

</Shell>
