<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Wegs_Cafe.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Wegs_Cafe"
    xmlns:views="clr-namespace:Wegs_Cafe.Views"
    Title="Wegs_Cafe">

    <TabBar>
        <Tab Title="Home">
            <ShellContent ContentTemplate="{DataTemplate views:HomePage}" Route="HomePage" />
        </Tab>

        <Tab Title="Menu">
            <ShellContent ContentTemplate="{DataTemplate views:MenuPage}" Route="MenuPage" />
        </Tab>

        <Tab Title="About">
            <ShellContent ContentTemplate="{DataTemplate views:AboutPage}" Route="AboutPage" />
        </Tab>

        <Tab Title="Contact">
            <ShellContent ContentTemplate="{DataTemplate views:ContactPage}" Route="ContactPage" />
        </Tab>

        <Tab Title="Login">
            <ShellContent ContentTemplate="{DataTemplate views:LoginPage}" Route="LoginPage" />
        </Tab>
    </TabBar>

</Shell>
